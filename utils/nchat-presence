PROGRAM = "nchat-presence"

# Producer-compatible plausibility bound for record timestamps (year 2286).
MAX_RECORD_TS = 10 ** 13

# Bidi control characters and other unsafe-for-terminal code points.
_UNSAFE_RANGES = ((0x00, 0x1F), (0x7F, 0x9F), (0xD800, 0xDFFF),
                  (0x202A, 0x202E), (0x2066, 0x2069), (0x200E, 0x200F),
                  (0x061C, 0x061C))


def default_appdir():
    """Mirror nchat's application-directory resolution (fileutil.cpp),
    plus the helper-specific NCHAT_CONFIG_DIR override."""
    env = os.environ.get("NCHAT_CONFIG_DIR")
    if env:
        return env
    home = os.environ.get("HOME", "")
    legacy = os.path.join(home, ".nchat") if home else ""
    if legacy and os.path.isdir(legacy):
        return legacy
    xdg = os.environ.get("XDG_CONFIG_HOME")
    config_home = xdg if xdg else (os.path.join(home, ".config") if home else ".config")
    return os.path.join(config_home, "nchat")


def default_dir():
    return os.path.join(default_appdir(), "presence")


def clean(text):
    """Render a string safely for a terminal: escape control, bidi and
    surrogate characters."""
    out = []
    for ch in text:
        code = ord(ch)
        if any(lo <= code <= hi for lo, hi in _UNSAFE_RANGES):
            out.append("\\u%04x" % code)
        else:
            out.append(ch)
    return "".join(out)


def warn(message):
    print("%s: warning: %s" % (PROGRAM, clean(message)), file=sys.stderr)


def load_contacts(appdir, profile):
    """Read the local nchat cache's contacts.

    Returns {"by_id": {id: (name, phone)},
             "by_phone": {digits: [(name, contact_id), ...]}}
    where masked phones (containing the bullet character) are never indexed.
    """
    by_id = {}
    by_phone = collections.defaultdict(list)
    if "/" in profile or profile in (".", ".."):
        return {"by_id": by_id, "by_phone": by_phone}
    db_path = os.path.join(appdir, "history", profile, "db.sqlite")
    if not os.path.isfile(db_path):
        return {"by_id": by_id, "by_phone": by_phone}
    uri = Path(os.path.abspath(db_path)).as_uri() + "?mode=ro"
    try:
        con = sqlite3.connect(uri, uri=True)
        try:
            rows = con.execute("SELECT id, name, phone FROM contacts2")
            for contact_id, name, phone in rows:
                name = name or ""
                phone = phone or ""
                by_id[contact_id] = (name, phone)
                if phone and "•" not in phone:
                    by_phone[digits_of(phone)].append((name or phone, contact_id))
        finally:
            con.close()
    except sqlite3.Error:
        pass  # locked or unreadable cache: fall back to raw ids
    return {"by_id": by_id, "by_phone": by_phone}


def load_all_contacts(appdir, directory):
    result = {}
    if not appdir:
        return result
    for path in glob.glob(os.path.join(directory, "history.*.jsonl")):
        profile = decode_profile(os.path.basename(path))
        result[profile] = load_contacts(appdir, profile)
    return result


def decode_profile(filename):
    base = filename.rsplit("history.", 1)[1].rsplit(".jsonl", 1)[0]
    try:
        return bytes.fromhex(base).decode("utf-8", errors="replace")
    except ValueError:
        return base


def fmt(ms):
    try:
        aware = datetime.datetime.fromtimestamp(ms / 1000).astimezone()
        return aware.strftime("%Y-%m-%d %H:%M:%S %z")
    except (OverflowError, OSError, ValueError):
        return "invalid time"


def seen_text(seen):
    if seen in (-1, 0, None):
        return "hidden/unknown"
    if seen == 1:
        return "last month"
    if seen == 2:
        return "last week"
    return fmt(seen)


def status_text(record):
    """One shared formatter for a sample record's state."""
    if record.get("on"):
        return "online"
    if record.get("recent"):
        return "seen recently"
    return "offline, seen " + seen_text(record.get("seen", -1))


def observable(record):
    """The producer's observable-data predicate: clears hidden state."""
    return bool(record.get("on")) or record.get("seen", -1) >= 0 or bool(record.get("recent"))


def parse_when(text):
    if not text:
        return None
    value = text.strip()
    if value.endswith("Z"):
        value = value[:-1] + "+00:00"
    parsed = None
    for candidate in (value, value + "T00:00:00"):
        try:
            parsed = datetime.datetime.fromisoformat(candidate)
            break
        except ValueError:
            parsed = None
    if parsed is None:
        sys.exit("cannot parse time %r (use YYYY-MM-DD or YYYY-MM-DD HH:MM)" % text)
    try:
        if parsed.tzinfo is None:
            parsed = parsed.astimezone()
        return int(parsed.timestamp() * 1000)
    except (OverflowError, OSError, ValueError):
        sys.exit("cannot parse time %r (use YYYY-MM-DD or YYYY-MM-DD HH:MM)" % text)


def valid_record(record):
    """Full schema validation: anything else is skipped with a warning."""
    if not isinstance(record, dict):
        return False
    ts = record.get("ts")
    uid = record.get("u")
    if not isinstance(ts, int) or isinstance(ts, bool) or ts <= 0:
        return False
    if ts > MAX_RECORD_TS:
        return False  # implausible timestamp (beyond year 2286)
    if not isinstance(uid, str) or not uid:
        return False
    if record.get("mark") == "hidden":
        return True
    if record.get("mark") is not None:
        return False  # unknown marker kinds are rejected
    on = record.get("on")
    if not isinstance(on, int) or isinstance(on, bool) or on not in (0, 1):
        return False
    seen = record.get("seen", -1)
    if not isinstance(seen, int) or isinstance(seen, bool):
        return False
    if seen not in (-1, 0, 1, 2) and not (0 < seen <= MAX_RECORD_TS):
        return False
    recent = record.get("recent", 0)
    if not isinstance(recent, int) or isinstance(recent, bool) or recent not in (0, 1):
        return False
    hb = record.get("hb", 0)
    if not isinstance(hb, int) or isinstance(hb, bool) or hb not in (0, 1):
        return False
    return True


def list_history_files(directory):
    """List history files, surfacing enumeration failures as warnings."""
    if not os.path.isdir(directory):
        sys.exit("no presence directory at %s" % directory)
    try:
        names = sorted(os.listdir(directory))
    except OSError as exc:
        warn("cannot list %s: %s" % (directory, exc))
        return []
    return [os.path.join(directory, name) for name in names
            if name.startswith("history.") and name.endswith(".jsonl")]


def iter_records(directory, profile_filter=None, since=None, until=None):
    for path in list_history_files(directory):
        profile = decode_profile(os.path.basename(path))
        if profile_filter and profile_filter not in profile:
            continue
        try:
            fh = open(path, "rb")
        except OSError as exc:
            warn("cannot read %s: %s" % (path, exc))
            continue
        try:
            for line_number, raw in enumerate(fh, 1):
                try:
                    line = raw.decode("utf-8").strip()
                except UnicodeDecodeError:
                    warn("%s:%d is not valid UTF-8; skipping" % (path, line_number))
                    continue
                if not line:
                    continue
                try:
                    record = json.loads(line)
                except (json.JSONDecodeError, ValueError, RecursionError):
                    continue  # torn tail or pathological nesting
                if not valid_record(record):
                    warn("skipping malformed record in %s:%d" % (path, line_number))
                    continue
                # Date bounds apply to every record kind, markers included.
                if since is not None and record["ts"] < since:
                    continue
                if until is not None and record["ts"] > until:
                    continue
                yield profile, record
        except OSError as exc:
            warn("error while reading %s: %s" % (path, exc))
        finally:
            fh.close()


def normalize_uid(profile, uid):
    # Telegram user ids are stored hex-encoded (ASCII of the numeric id).
    if profile.startswith("Telegram") and uid and all(c in "0123456789abcdef" for c in uid):
        try:
            return bytes.fromhex(uid).decode("ascii")
        except (ValueError, UnicodeDecodeError):
            pass
    return uid


def short_id(uid):
    """Unambiguous short form: phone JIDs lose their suffix, LIDs keep it."""
    if uid.endswith("@s.whatsapp.net"):
        return uid[: -len("@s.whatsapp.net")]
    if uid.endswith("@newsletter") or uid.endswith("@broadcast"):
        return uid[: -len("@newsletter")]
    return uid  # LIDs and other ids stay fully qualified


def digits_of(value):
    return "".join(c for c in value if c.isdigit())


def resolve_name(profile, uid, contacts):
    entry = contacts.get("by_id", {}).get(uid)
    if entry:
        name, phone = entry
        if name:
            return name, phone
    if profile.startswith("Telegram"):
        return (entry[0] or entry[1], entry[1]) if entry else (None, "")
    # Phone fallback: only genuine phone JIDs, and only through complete,
    # unmasked cached phone values (never LID digits).
    if uid.endswith("@s.whatsapp.net"):
        phone_digits = digits_of(uid)
        matches = [name for name, _ in contacts.get("by_phone", {}).get(phone_digits, [])]
        if len(matches) == 1:
            return matches[0], phone_digits
    return None, ""


def identity_parts(profile, uid, contacts_by_profile, args):
    """Return (name-or-empty, unambiguous id text)."""
    id_text = normalize_uid(profile, uid) if profile.startswith("Telegram") else short_id(uid)
    name = ""
    if not args.no_names:
        name, _ = resolve_name(profile, uid, contacts_by_profile.get(profile, {}))
    return (name or ""), id_text


def display_id(profile, uid, contacts_by_profile, args):
    name, id_text = identity_parts(profile, uid, contacts_by_profile, args)
    if name:
        return clean("%s <%s>" % (name, id_text))
    return clean(id_text)


def pattern_matches(profile, uid, pattern, contacts_by_profile, args, resolution_cache):
    pattern = pattern.casefold()
    if pattern in uid.casefold() or pattern in normalize_uid(profile, uid).casefold():
        return True
    if pattern in short_id(uid).casefold():
        return True
    if args.no_names:
        return False
    name, phone = resolution_cache.get((profile, uid), (None, None))
    if name is None and (profile, uid) not in resolution_cache:
        name, phone = resolve_name(profile, uid, contacts_by_profile.get(profile, {}))
        resolution_cache[(profile, uid)] = (name, phone)
    if name and pattern in name.casefold():
        return True
    if phone and pattern in phone.casefold():
        return True
    return False


def aggregate(directory, profile_filter, since, until, pattern, contacts, args):
    """One pass over the history: per-contact aggregates. The displayed
    state follows every genuine sample; the hidden lifecycle is tracked in
    append order (immune to wall-clock rollbacks), and only observable
    samples retire a hidden mark."""
    stats = {}
    resolution_cache = {}
    for profile, record in iter_records(directory, profile_filter, since, until):
        uid = record["u"]
        if pattern and not pattern_matches(profile, uid, pattern, contacts, args,
                                           resolution_cache):
            continue
        key = (profile, uid)
        s = stats.get(key)
        if s is None:
            s = stats[key] = {"count": 0, "online": 0, "heartbeats": 0,
                              "last_ts": 0, "first_obs_ts": 0,
                              "last_state": None, "hidden_order": 0, "obs_order": 0,
                              "order": 0, "hidden_ts": 0}
        s["order"] += 1
        order = s["order"]
        if record.get("mark") == "hidden":
            s["hidden_order"] = order
            s["hidden_ts"] = max(s["hidden_ts"], record["ts"])
        elif record.get("hb"):
            s["heartbeats"] += 1
        else:
            s["count"] += 1
            if record.get("on"):
                s["online"] += 1
            # The displayed state follows every genuine sample, even
            # no-data ones (an offline sample after online must not leave
            # the contact displayed as online).
            s["last_state"] = status_text(record)
            if observable(record):
                s["obs_order"] = order
                if s["first_obs_ts"] == 0:
                    s["first_obs_ts"] = record["ts"]
        if record["ts"] > s["last_ts"]:
            s["last_ts"] = record["ts"]
    return stats


def skipped_state(s):
    """Hidden, unless an observable sample arrived after the marker in
    append order."""
    if s["hidden_order"] == 0:
        return False
    return s["obs_order"] < s["hidden_order"]


def cell(text, width):
    """Plain truncation with an ellipsis (no '<id>' awareness)."""
    if len(text) <= width:
        return text.ljust(width)
    return (text[: width - 1] + "…").ljust(width)


def name_id_cell(name, id_text, width):
    """Truncate the display NAME only; the '<id>' suffix is always kept
    intact."""
    if name:
        suffix = " <%s>" % id_text
        if len(suffix) >= width:
            return (suffix[: width - 1] + "…").ljust(width) if width > 1 else suffix[:width].ljust(width)
        available = width - len(suffix)
        head = name[:available]
        if len(name) > available:
            head += "…"
        return (head + suffix).ljust(width)
    return cell(id_text, width)


def raw_display_id(profile, uid, contacts_by_profile, args):
    """Unescaped display form, for width computation before cleaning."""
    name, id_text = identity_parts(profile, uid, contacts_by_profile, args)
    if name:
        return "%s <%s>" % (name, id_text)
    return id_text


def cmd_list(args):
    since = parse_when(args.since)
    until = parse_when(args.until)
    contacts = {} if args.no_names else load_all_contacts(args.appdir, args.dir)
    stats = aggregate(args.dir, args.profile, since, until, args.pattern, contacts, args)
    if not stats:
        if args.pattern:
            sys.exit("no records match %r" % args.pattern)
        print("no presence history found")
        return
    rows = []
    for (profile, uid), s in sorted(stats.items(), key=lambda kv: -kv[1]["last_ts"]):
        if skipped_state(s):
            state = "skipped (hidden)"
        elif s["last_state"] is not None:
            state = s["last_state"]
        else:
            state = "unknown"
        name, id_text = identity_parts(profile, uid, contacts, args)
        rows.append((clean(profile), name, id_text, fmt(s["last_ts"]), state,
                     s["count"], s["online"], s["heartbeats"]))
    profile_width = min(max((len(r[0]) for r in rows), default=12) + 2, 28)
    name_width = min(max((len(name_id_cell(r[1], r[2], 60)) for r in rows), default=12) + 2, 44)
    for profile, name, id_text, last, state, count, online, heartbeats in rows:
        print("%s%s%s  %s  (%d samples, %d online, %d heartbeats)"
              % (cell(profile, profile_width),
                 clean(name_id_cell(name, id_text, name_width - 1)), last,
                 state, count, online, heartbeats))


def current_contacts(args):
    """Keep only each contact's last reported state. Heartbeats aren't observations."""
    if not os.path.isdir(args.dir):
        return []
    contacts = {} if args.no_names else load_all_contacts(args.appdir, args.dir)
    latest = {}
    for profile, record in iter_records(args.dir, args.profile):
        if record.get("hb"):
            continue
        key = (profile, record["u"])
        item = latest.setdefault(key, {"key": key, "record": None, "hidden": False})
        if record.get("mark") == "hidden":
            item["hidden"] = True
        else:
            item["record"] = record
            if observable(record):
                item["hidden"] = False
    for (profile, uid), item in latest.items():
        name, identifier = identity_parts(profile, uid, contacts, args)
        service = "WhatsApp" if profile.startswith("WhatsApp") else "Telegram" if profile.startswith("Telegram") else "Other"
        if not name.strip() or name in (uid, identifier):
            name = ("+" + identifier if uid.endswith("@s.whatsapp.net")
                    else "Contact " + identifier)
        item.update(name=clean(name.strip()), identifier=clean(identifier), service=service)
    return sorted(latest.values(), key=lambda item: (item["service"], item["name"].casefold(), item["key"]))


def report_age(timestamp, now):
    if not timestamp:
        return "No report"
    if timestamp > now + 60_000:
        return "Clock mismatch"
    seconds = max(0, (now - timestamp) // 1000)
    if seconds < 60:
        return "Just now"
    if seconds < 3600:
        return "%dm ago" % (seconds // 60)
    if seconds < 86400:
        return "%dh ago" % (seconds // 3600)
    return "%dd ago" % (seconds // 86400)


def readable_seen(timestamp, now):
    if timestamp in (None, -1, 0):
        return "Unavailable"
    if timestamp == 1:
        return "Within last month"
    if timestamp == 2:
        return "Within last week"
    seen = datetime.datetime.fromtimestamp(timestamp / 1000).astimezone()
    today = datetime.datetime.fromtimestamp(now / 1000).astimezone().date()
    if seen.date() == today:
        return "Today " + seen.strftime("%H:%M")
    if seen.date() == today - datetime.timedelta(days=1):
        return "Yesterday " + seen.strftime("%H:%M")
    return seen.strftime("%d %b %Y, %H:%M")


def readable_report(timestamp):
    return datetime.datetime.fromtimestamp(timestamp / 1000).astimezone().strftime('%a %d %b, %H:%M:%S %Z')


def current_fields(item, now):
    record = item["record"]
    if item["hidden"] or record is None:
        return "Unavailable", "Unavailable", "No fresh report"
    age = report_age(record["ts"], now)
    if age == "Clock mismatch":
        return "Unconfirmed", "Unavailable", age
    fresh = 0 <= now - record["ts"] <= 300_000
    if record.get("on"):
        # A cached heartbeat cannot renew an online claim.
        state = "Online" if fresh else "Unconfirmed"
        return state, "—", age
    if record.get("recent"):
        return ("Seen recently" if fresh else "Approx. (old)"), "Seen recently", age
    if record.get("seen", -1) <= 0:
        return "Unavailable", "Unavailable", age
    return ("Offline" if fresh else "Offline (old)"), readable_seen(record["seen"], now), age


_libc = ctypes.CDLL(ctypes.util.find_library("c") or None)
_libc.wcwidth.argtypes = [ctypes.c_wchar]
_libc.wcwidth.restype = ctypes.c_int


def screen_text(text):
    """Use stable terminal cells for emoji modifiers, joiners and flag pairs."""
    text = clean(str(text))
    result = []
    for char in text:
        code = ord(char)
        if 0x1F1E6 <= code <= 0x1F1FF:
            result.append(chr(ord('A') + code - 0x1F1E6))
        elif 0x1F3FB <= code <= 0x1F3FF or char in ('\ufe0f', '\ufe0e'):
            continue
        elif char == '\u200d':
            result.append(' ')
        else:
            result.append(char)
    return ''.join(result)


def fit_screen(text, width):
    """Clip by terminal cells, retaining accents attached to the last base."""
    text = screen_text(text)
    if width <= 0:
        return ""
    if sum(max(0, _libc.wcwidth(char)) for char in text) <= width:
        return text
    result = []
    used = 0
    for char in text:
        cells = max(0, _libc.wcwidth(char))
        if used + cells > width - 1:
            break
        result.append(char)
        used += cells
    return ''.join(result) + '…'


def current_rows(contacts, query, service):
    query = query.casefold()
    return [item for item in contacts if service in ('All', item['service']) and
            query in (item['name'] + ' ' + item['identifier']).casefold()]


def current_lines(contacts, width, now):
    lines = []
    services = sorted({item['service'] for item in contacts})
    for service in services:
        group = [item for item in contacts if item['service'] == service]
        if lines:
            lines.append(('', None, 'group'))
        lines.append((service.upper() + '  ·  ' + str(len(group)), None, 'group'))
        for item in group:
            state, seen, age = current_fields(item, now)
            if width >= 94:
                name_width = width - 62
                name = fit_screen(item['name'], name_width)
                padding = name_width - sum(max(0, _libc.wcwidth(char)) for char in name)
                text = '  ' + name + ' ' * padding + '  ' + state.ljust(14) + '  ' + seen.ljust(23) + '  ' + age
                lines.append((text, item['key'], state))
            else:
                lines.append(('  ' + item['name'], item['key'], state))
                detail = state + '  ·  ' + age
                if width >= 64:
                    detail += '  ·  ' + seen
                lines.append(('    ' + detail, item['key'], state))
    return lines


def print_current(args):
    now = int(time.time() * 1000)
    rows = current_rows(current_contacts(args), args.pattern, 'All')
    print('NCHAT  ·  Latest reported status')
    print('Local cache  ·  ' + datetime.datetime.now().astimezone().strftime('%d %b %Y %H:%M %Z'))
    print('Reports older than 5 minutes are labelled old or unconfirmed.\n')
    if not rows:
        print('No contacts match.' if args.pattern else 'No status reports available yet.')
        return
    print('  ' + 'CONTACT'.ljust(38) + '  ' + 'STATUS'.ljust(14) + '  ' + 'LAST SEEN'.ljust(23) + '  REPORT AGE')
    for text, _, _ in current_lines(rows, 100, now):
        print(fit_screen(text, 100))


def browse_current(win, args):
    import curses
    if hasattr(curses, 'set_escdelay') and 'ESCDELAY' not in os.environ:
        curses.set_escdelay(50)
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    win.keypad(True)
    win.timeout(1000)
    colors = False
    if curses.has_colors() and 'NO_COLOR' not in os.environ:
        try:
            curses.start_color()
            curses.use_default_colors()
            curses.init_pair(1, curses.COLOR_CYAN, -1)
            curses.init_pair(2, curses.COLOR_GREEN, -1)
            colors = True
        except curses.error:
            pass
    errors = io.StringIO()
    with contextlib.redirect_stderr(errors):
        contacts = current_contacts(args)
    query, service, searching, selection, top = args.pattern, 'All', False, 0, 0
    loaded_at = datetime.datetime.now().astimezone()
    note = ('Some cache records could not be read. r retries.' if errors.getvalue()
            else 'r refreshes the local cache')
    while True:
        rows = current_rows(contacts, query, service)
        selection = min(selection, max(0, len(rows) - 1))
        selected = rows[selection]['key'] if rows else None
        height, width = win.getmaxyx()
        now = int(time.time() * 1000)
        lines = current_lines(rows, max(1, width - 1), now)
        page = max(1, height - 10)
        selected_line = next((i for i, line in enumerate(lines) if line[1] == selected), 0)
        if selected_line < top:
            top = max(0, selected_line - 1)
        selected_end = max((i for i, line in enumerate(lines) if line[1] == selected), default=selected_line)
        if selected_end >= top + page:
            top = selected_end - page + 1
        top = max(0, min(top, max(0, len(lines) - page)))
        win.erase()

        def put(y, text, attribute=0):
            if 0 <= y < height and width > 1:
                try:
                    win.addstr(y, 0, fit_screen(text, width - 1), attribute)
                except curses.error:
                    pass  # A terminal resize can race drawing.

        put(0, ' NCHAT  /  Latest status', curses.A_BOLD)
        put(1, ' Read at ' + loaded_at.strftime('%H:%M %Z') + '  ·  ' + str(len(rows)) + ' contacts')
        put(2, ' ' + ('ALL SERVICES' if service == 'All' else service.upper()) + '  ·  /' + query + ('_' if searching else ''), curses.A_REVERSE)
        put(3, ' Last reported status · >5m = old' if width < 95 else
            '  ' + 'CONTACT'.ljust(width - 63) + '  ' + 'STATUS'.ljust(14) + '  ' + 'LAST SEEN'.ljust(23) + '  REPORT AGE', curses.A_DIM)
        for i, (text, key, kind) in enumerate(lines[top:top + page]):
            attribute = curses.A_BOLD if kind == 'group' else 0
            if colors and kind in ('group', 'Online'):
                attribute |= curses.color_pair(1 if kind == 'group' else 2)
            if key is not None and key == selected:
                attribute |= curses.A_REVERSE
                if top + i == selected_line:
                    text = '› ' + text[2:]
            put(4 + i, text, attribute)
        if not rows:
            put(5, ' No contacts match. Esc clears search; Tab changes service.' if query or service != 'All' else ' No status reports available yet.')
        if rows and height >= 12:
            item = rows[selection]
            profiles = sorted({value['key'][0] for value in contacts if value['service'] == item['service']})
            account = (' / Account ' + str(profiles.index(item['key'][0]) + 1)) if len(profiles) > 1 else ''
            put(height - 6, ' ' + item['name'] + '  ·  ' + item['service'] + account, curses.A_BOLD)
            put(height - 5, ' ' + item['identifier'])
            _, seen, age = current_fields(item, now)
            detail = ('Seen ' + seen + ' · report ' + age if width < 64 else
                      'Last seen ' + seen + '  ·  ' + ('Reported ' + readable_report(item['record']['ts']) if item['record'] else 'No observation'))
            put(height - 4, ' ' + detail)
        put(height - 3, ' ' + note, curses.A_DIM)
        if width < 72:
            put(height - 2, ' ↑↓ Move  / Search  Tab Service')
            put(height - 1, ' q Quit  r Refresh  Esc Clear')
        else:
            put(height - 2, ' ↑↓ / j k  Move   Tab  Service   /  Search   r  Refresh')
            put(height - 1, ' q Quit  Esc Clear  PgUp/PgDn Page  g/G First/last')
        if height < 12 or width < 26:
            win.erase()
            put(0, 'q Quit · Enlarge terminal')
        win.refresh()
        try:
            key = win.get_wch()
        except curses.error:
            continue
        if key == curses.KEY_RESIZE:
            continue
        if searching:
            if key in ('\n', '\r', curses.KEY_ENTER):
                searching = False
            elif key in ('\x1b', '\x03'):
                query, searching = '', False
            elif key in ('\x7f', '\b', curses.KEY_BACKSPACE):
                query = query[:-1]
            elif isinstance(key, str) and key.isprintable() and len(query) < 120:
                query += key
            selection, top = 0, 0
            continue
        if key in ('q', 'Q', '\x03'):
            return
        if key in (curses.KEY_DOWN, 'j'):
            selection += 1
        elif key in (curses.KEY_UP, 'k'):
            selection = max(0, selection - 1)
        elif key in (curses.KEY_NPAGE, curses.KEY_PPAGE):
            selection = max(0, selection + (1 if key == curses.KEY_NPAGE else -1) * max(1, page // 2))
        elif key in ('g', curses.KEY_HOME):
            selection = 0
        elif key in ('G', curses.KEY_END):
            selection = max(0, len(rows) - 1)
        elif key == '\t':
            services = ['All', 'WhatsApp', 'Telegram']
            service = services[(services.index(service) + 1) % len(services)]
            selection, top = 0, 0
        elif key == '/':
            searching = True
        elif key == '\x1b':
            query, service, selection, top = '', 'All', 0, 0
        elif key in ('r', 'R'):
            errors = io.StringIO()
            try:
                with contextlib.redirect_stderr(errors):
                    contacts = current_contacts(args)
                visible = current_rows(contacts, query, service)
                selection = next((i for i, item in enumerate(visible) if item['key'] == selected), 0)
                loaded_at = datetime.datetime.now().astimezone()
                note = 'Refreshed ' + loaded_at.strftime('%H:%M')
                if errors.getvalue():
                    note += '  ·  Some cache records could not be read'
            except (OSError, SystemExit):
                note = 'Could not refresh the cache. Press r to retry.'


def cmd_current(args):
    if args.plain or not (sys.stdin.isatty() and sys.stdout.isatty()):
        print_current(args)
    else:
        import curses
        try:
            curses.wrapper(browse_current, args)
        except KeyboardInterrupt:
            return
        except curses.error:
            sys.exit('This terminal could not open the status screen. Use nchat-presence current --plain.')


def cmd_show(args):
    since = parse_when(args.since)
    until = parse_when(args.until)
    contacts = {} if args.no_names else load_all_contacts(args.appdir, args.dir)
    resolution_cache = {}

    # Single pass: collect the globally latest N matching records across
    # profiles (bounded heap), and detect multi-profile matches for the
    # attribution prefix.
    matched_profiles = set()
    heap = []
    seq = 0
    for profile, record in iter_records(args.dir, args.profile, since, until):
        if not pattern_matches(profile, record["u"], args.pattern, contacts, args,
                               resolution_cache):
            continue
        if record.get("mark") == "hidden":
            pass
        elif args.online_only and not record.get("on"):
            continue
        elif args.no_heartbeats and record.get("hb"):
            continue
        # Only rows that will actually be printed count toward the
        # multi-profile attribution prefix.
        matched_profiles.add(profile)
        item = (record["ts"], seq, profile, record)
        seq += 1
        if args.n < sys.maxsize:
            if len(heap) < args.n:
                heapq.heappush(heap, item)
            elif item[0] > heap[0][0]:
                heapq.heapreplace(heap, item)
        else:
            heap.append(item)

    if not heap:
        sys.exit("no records match %r (patterns match user ids/numbers and display names)"
                 % args.pattern)

    multi_profile = len(matched_profiles) > 1
    kept = sorted(heap)  # (ts, seq, ...) -> chronological, deterministic ties

    # Resolve each kept contact once.
    display_cache = {}
    for _, _, profile, record in kept:
        key = (profile, record["u"])
        if key not in display_cache:
            display_cache[key] = display_id(profile, record["u"], contacts, args)

    for _, _, profile, record in kept:
        who = display_cache[(profile, record["u"])]
        prefix = ("[%s] " % clean(profile)) if multi_profile else ""
        if record.get("mark") == "hidden":
            print("%s  %s%s marked hidden (skipped)" % (fmt(record["ts"]), prefix, who))
            continue
        kind = "hb " if record.get("hb") else "   "
        print("%s  %s %s%s %s" % (fmt(record["ts"]), kind, prefix, who, status_text(record)))


def cmd_summary(args):
    since = parse_when(args.since)
    until = parse_when(args.until)
    contacts = {} if args.no_names else load_all_contacts(args.appdir, args.dir)
    stats = aggregate(args.dir, args.profile, since, until, args.pattern, contacts, args)
    if not stats:
        sys.exit("no records match %r" % args.pattern)
    for (profile, uid), s in sorted(stats.items(), key=lambda kv: -kv[1]["last_ts"]):
        print("%s / %s" % (clean(profile), display_id(profile, uid, contacts, args)))
        print("  first sample : %s" % (fmt(s["first_obs_ts"]) if s["first_obs_ts"] else "none"))
        print("  last record  : %s" % (fmt(s["last_ts"]) if s["last_ts"] else "none"))
        if skipped_state(s):
            state = "skipped (hidden)"
        elif s["last_state"] is not None:
            state = s["last_state"]
        else:
            state = "unknown"
        print("  last state   : %s" % state)
        print("  online events: %d (genuine samples only)" % s["online"])
        print("  heartbeats   : %d" % s["heartbeats"])
        if s["hidden_ts"]:
            print("  hidden mark  : %s" % fmt(s["hidden_ts"]))


def check(condition, message):
    if not condition:
        raise RuntimeError("self-test FAILED: %s" % message)


