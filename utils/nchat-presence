# Read-only CLI for the nchat continuous presence polling history.
# Parses the local JSONL files written by the presence poller under
# <config>/nchat/presence/ and never contacts any service.
#
# Usage:
#   nchat-presence list [--dir DIR] [--profile NAME]
#   nchat-presence show PATTERN [--dir DIR] [--profile NAME] [-n N] [--no-heartbeats]
#   nchat-presence summary [PATTERN] [--dir DIR] [--profile NAME]
#   nchat-presence --self-test

import argparse
import datetime
import glob
import json
import os
import sqlite3
import sys
import tempfile

HEARTBEAT_SEC = 300


def default_dir():
    env = os.environ.get("NCHAT_CONFIG_DIR")
    if env:
        return os.path.join(env, "presence")
    return os.path.join(os.environ.get("HOME", "."), ".config", "nchat", "presence")


def default_appdir(directory):
    # <appdir>/presence -> <appdir>
    parent = os.path.dirname(directory.rstrip("/"))
    return parent if parent else directory


def load_contacts(appdir, profile):
    """Read the local nchat cache's contact names (id -> (name, phone))."""
    contacts = {}
    db_path = os.path.join(appdir, "history", profile, "db.sqlite")
    if not os.path.isfile(db_path):
        return contacts
    try:
        con = sqlite3.connect("file:%s?mode=ro" % db_path, uri=True)
        try:
            rows = con.execute("SELECT id, name, phone FROM contacts2")
            for contact_id, name, phone in rows:
                contacts[contact_id] = (name or "", phone or "")
        finally:
            con.close()
    except sqlite3.Error:
        pass  # locked or unreadable cache: fall back to raw ids
    return contacts


def short_id(uid):
    # WhatsApp JID -> phone-like part; leave other ids unchanged
    for suffix in ("@s.whatsapp.net", "@lid", "@newsletter", "@broadcast"):
        if uid.endswith(suffix):
            return uid[: -len(suffix)]
    return uid


def resolve_name(profile, uid, contacts):
    if profile.startswith("Telegram"):
        entry = contacts.get(uid)
        if entry:
            name, phone = entry
            return name or phone
        return None
    # WhatsApp: exact JID match first, then by the numeric part (the cache
    # may key contacts by LID while the history stores the phone JID).
    entry = contacts.get(uid)
    if entry:
        name, phone = entry
        if name:
            return name
    digits = "".join(c for c in uid if c.isdigit())
    if digits:
        for contact_id, (name, phone) in contacts.items():
            if name and "".join(c for c in contact_id if c.isdigit()) == digits:
                return name
    return None


def decode_profile(filename):
    base = filename.rsplit("history.", 1)[1].rsplit(".jsonl", 1)[0]
    try:
        return bytes.fromhex(base).decode("utf-8", errors="replace")
    except ValueError:
        return base


def fmt(ms):
    return datetime.datetime.fromtimestamp(ms / 1000).strftime("%Y-%m-%d %H:%M:%S")


def seen_text(seen):
    if seen == -1:
        return "hidden/unknown"
    if seen == 1:
        return "last month"
    if seen == 2:
        return "last week"
    return fmt(seen)


def iter_records(directory, profile_filter=None):
    if not os.path.isdir(directory):
        sys.exit("no presence directory at %s" % directory)
    for path in sorted(glob.glob(os.path.join(directory, "history.*.jsonl"))):
        profile = decode_profile(os.path.basename(path))
        if profile_filter and profile_filter not in profile:
            continue
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    record = json.loads(line)
                except json.JSONDecodeError:
                    continue  # torn tail being repaired by the poller
                yield profile, record


def normalize_uid(profile, uid):
    # Telegram user ids are stored hex-encoded (ASCII of the numeric id).
    if profile.startswith("Telegram") and uid and all(c in "0123456789abcdef" for c in uid):
        try:
            return bytes.fromhex(uid).decode("ascii")
        except (ValueError, UnicodeDecodeError):
            pass
    return uid


def match_uid(profile, uid, pattern):
    if pattern in uid or pattern in normalize_uid(profile, uid):
        return True
    return False


def load_all_contacts(appdir, directory):
    """Contact names per profile, keyed by profile id."""
    result = {}
    if not appdir:
        return result
    for path in glob.glob(os.path.join(directory, "history.*.jsonl")):
        profile = decode_profile(os.path.basename(path))
        result[profile] = load_contacts(appdir, profile)
    return result


def display_id(profile, uid, contacts_by_profile, args):
    """Show the display name when the local cache has one, else the id."""
    id_text = normalize_uid(profile, uid) if profile.startswith("Telegram") else short_id(uid)
    if not args.no_names:
        name = resolve_name(profile, uid, contacts_by_profile.get(profile, {}))
        if name:
            return "%s <%s>" % (name, id_text)
    return id_text


def cmd_list(args):
    stats = {}
    for profile, record in iter_records(args.dir, args.profile):
        if "mark" in record:
            continue
        key = (profile, record["u"])
        s = stats.get(key)
        if s is None:
            s = stats[key] = {"count": 0, "online": 0, "last_ts": 0, "last_on": None,
                              "last_seen": None, "marked_hidden": False}
        s["count"] += 1
        if record.get("on"):
            s["online"] += 1
        if record["ts"] > s["last_ts"]:
            s["last_ts"] = record["ts"]
            s["last_on"] = bool(record.get("on"))
            s["last_seen"] = record.get("seen")
    for profile, record in iter_records(args.dir, args.profile):
        if record.get("mark") == "hidden":
            s = stats.get((profile, record["u"]))
            if s is not None:
                s["marked_hidden"] = True
    if not stats:
        print("no presence history found")
        return
    contacts = {} if args.no_names else load_all_contacts(args.appdir, args.dir)
    for (profile, uid), s in sorted(stats.items(), key=lambda kv: -kv[1]["last_ts"]):
        if s["last_on"]:
            state = "online"
        else:
            state = "offline, seen " + seen_text(s["last_seen"])
        state += ", skipped (hidden)" if s["marked_hidden"] else ""
        print("%-24s %-28s %s  %s  (%d records, %d online)"
              % (profile, display_id(profile, uid, contacts, args),
                 fmt(s["last_ts"]), state, s["count"], s["online"]))


def cmd_show(args):
    contacts = {} if args.no_names else load_all_contacts(args.appdir, args.dir)
    shown = 0
    for profile, record in iter_records(args.dir, args.profile):
        if not match_uid(profile, record["u"], args.pattern):
            continue
        who = display_id(profile, record["u"], contacts, args)
        if record.get("mark") == "hidden":
            print("%s  %s  marked hidden (skipped)" % (fmt(record["ts"]), who))
            shown += 1
            continue
        if args.no_heartbeats and record.get("hb"):
            continue
        if shown >= args.n:
            break
        kind = "hb " if record.get("hb") else "   "
        if record.get("on"):
            state = "ONLINE"
        else:
            state = "offline"
        print("%s  %s %-7s seen %s" % (fmt(record["ts"]), kind, state,
                                        seen_text(record.get("seen", -1))))
        shown += 1
    if shown == 0:
        sys.exit("no records match %r" % args.pattern)


def cmd_summary(args):
    contacts = {} if args.no_names else load_all_contacts(args.appdir, args.dir)
    aggregates = {}
    for profile, record in iter_records(args.dir, args.profile):
        if args.pattern and not match_uid(profile, record["u"], args.pattern):
            continue
        key = (profile, record["u"])
        s = aggregates.get(key)
        if s is None:
            s = aggregates[key] = {"first_ts": None, "last_ts": None, "online": 0,
                                   "hidden": False, "last_on": None, "last_seen": None}
        if record.get("mark") == "hidden":
            s["hidden"] = True
            continue
        ts = record["ts"]
        s["first_ts"] = ts if s["first_ts"] is None else min(s["first_ts"], ts)
        if s["last_ts"] is None or ts > s["last_ts"]:
            s["last_ts"] = ts
            s["last_on"] = bool(record.get("on"))
            s["last_seen"] = record.get("seen")
        if record.get("on"):
            s["online"] += 1
    if not aggregates:
        print("no records match")
        return
    for (profile, uid), s in sorted(aggregates.items(), key=lambda kv: -(kv[1]["last_ts"] or 0)):
        print("%s / %s" % (profile, display_id(profile, uid, contacts, args)))
        print("  first record : %s" % (fmt(s["first_ts"]) if s["first_ts"] else "never"))
        print("  last record  : %s" % (fmt(s["last_ts"]) if s["last_ts"] else "never"))
        if s["last_on"]:
            state = "online"
        else:
            state = "offline, seen " + seen_text(s["last_seen"])
        print("  current state: %s" % state)
        print("  online events: %d" % s["online"])
        if s["hidden"]:
            print("  skipped     : yes (no observable data across the window)")


def self_test():
    import io
    import contextlib
    with tempfile.TemporaryDirectory(prefix="nchat-presence-self-test.") as appdir:
        profile = "Telegram_test"
        presence_dir = os.path.join(appdir, "presence")
        os.makedirs(presence_dir)
        history_path = os.path.join(presence_dir,
                                    "history." + profile.encode().hex() + ".jsonl")
        with open(history_path, "w", encoding="utf-8") as fh:
            fh.write('{"ts":1700000000000,"u":"3631323334","on":0,"seen":1699990000000,"recent":0}\n')
            fh.write('{"ts":1700000300000,"u":"3631323334","on":0,"seen":1699990000000,"recent":0,"hb":1}\n')
            fh.write('{"ts":1700000600000,"u":"3631323334","on":1,"seen":-1,"recent":0}\n')
        # Synthetic contact cache: the hex uid resolves to a display name.
        history_dir = os.path.join(appdir, "history", profile)
        os.makedirs(history_dir)
        con = sqlite3.connect(os.path.join(history_dir, "db.sqlite"))
        con.execute("CREATE TABLE contacts2 (id TEXT, name TEXT, phone TEXT, "
                    "isSelf INT, isAlias INT, UNIQUE(id) ON CONFLICT REPLACE)")
        con.execute("INSERT INTO contacts2 VALUES ('3631323334', 'Test Name', '61234', 0, 0)")
        con.commit()
        con.close()

        args = argparse.Namespace(dir=presence_dir, appdir=appdir, profile=None,
                                  pattern="61234", n=200, no_names=False, no_heartbeats=False)
        output = io.StringIO()
        with contextlib.redirect_stdout(output):
            cmd_list(args)
        listing = output.getvalue()
        assert "Test Name <61234>" in listing, listing
        output = io.StringIO()
        with contextlib.redirect_stdout(output):
            cmd_summary(args)
        summary = output.getvalue()
        assert "Test Name <61234>" in summary, summary
        output = io.StringIO()
        with contextlib.redirect_stdout(output):
            cmd_show(args)
        shown = output.getvalue()
        assert "offline" in shown and "ONLINE" in shown, shown
        args.no_names = True
        output = io.StringIO()
        with contextlib.redirect_stdout(output):
            cmd_list(args)
        assert "Test Name" not in output.getvalue()
    print("self-test: list, show, summary and name resolution all passed")
    return 0


def main():
    parser = argparse.ArgumentParser(prog="nchat-presence",
                                     description="Read the local nchat presence polling history")
    parser.add_argument("command", nargs="?", choices=["list", "show", "summary"],
                        help="list contacts / show one contact's history / summarize")
    parser.add_argument("pattern", nargs="?", default="",
                        help="user id (or substring) to filter; for show, required")
    parser.add_argument("--dir", default=default_dir(), help="presence directory (default %(default)s)")
    parser.add_argument("--appdir", default=None,
                        help="nchat config dir for display-name lookup (default: parent of --dir)")
    parser.add_argument("--profile", default=None, help="only match profiles containing this text")
    parser.add_argument("-n", type=int, default=200, help="max records for show (default 200)")
    parser.add_argument("--no-heartbeats", action="store_true",
                        help="hide heartbeat re-affirmation lines in show")
    parser.add_argument("--no-names", action="store_true",
                        help="do not resolve display names from the local cache")
    parser.add_argument("--self-test", action="store_true", help=argparse.SUPPRESS)
    args = parser.parse_args()

    if args.appdir is None:
        args.appdir = default_appdir(args.dir)

    if args.self_test:
        return self_test()
    if args.command == "list" or args.command is None:
        cmd_list(args)
    elif args.command == "show":
        if not args.pattern:
            sys.exit("show needs a user id pattern")
        cmd_show(args)
    elif args.command == "summary":
        cmd_summary(args)
    return 0


if __name__ == "__main__":
    sys.exit(main())
