PROGRAM = "nchat-presence"

# Producer-compatible plausibility bound for record timestamps (year 2286).
MAX_RECORD_TS = 10 ** 13

# Bidi control characters and other unsafe-for-terminal code points.
_UNSAFE_RANGES = ((0x00, 0x1F), (0x7F, 0x9F), (0xD800, 0xDFFF),
                  (0x202A, 0x202E), (0x2066, 0x2069), (0x200E, 0x200F),
                  (0x061C, 0x061C))


def default_appdir():
    """Mirror nchat's application-directory resolution (fileutil.cpp),
    plus the helper-specific NCHAT_CONFIG_DIR override."""
    env = os.environ.get("NCHAT_CONFIG_DIR")
    if env:
        return env
    home = os.environ.get("HOME", "")
    legacy = os.path.join(home, ".nchat") if home else ""
    if legacy and os.path.isdir(legacy):
        return legacy
    xdg = os.environ.get("XDG_CONFIG_HOME")
    config_home = xdg if xdg else (os.path.join(home, ".config") if home else ".config")
    return os.path.join(config_home, "nchat")


def default_dir():
    return os.path.join(default_appdir(), "presence")


def clean(text):
    """Render a string safely for a terminal: escape control, bidi and
    surrogate characters."""
    out = []
    for ch in text:
        code = ord(ch)
        if any(lo <= code <= hi for lo, hi in _UNSAFE_RANGES):
            out.append("\\u%04x" % code)
        else:
            out.append(ch)
    return "".join(out)


def warn(message):
    print("%s: warning: %s" % (PROGRAM, clean(message)), file=sys.stderr)


def load_contacts(appdir, profile):
    """Read the local nchat cache's contacts.

    Returns {"by_id": {id: (name, phone)},
             "by_phone": {digits: [(name, contact_id), ...]}}
    where masked phones (containing the bullet character) are never indexed.
    """
    by_id = {}
    self_ids = set()
    by_phone = collections.defaultdict(list)
    if "/" in profile or profile in (".", ".."):
        return {"by_id": by_id, "by_phone": by_phone}
    db_path = os.path.join(appdir, "history", profile, "db.sqlite")
    if not os.path.isfile(db_path):
        return {"by_id": by_id, "by_phone": by_phone}
    uri = Path(os.path.abspath(db_path)).as_uri() + "?mode=ro"
    try:
        con = sqlite3.connect(uri, uri=True)
        try:
            rows = con.execute("SELECT id, name, phone FROM contacts2")
            for contact_id, name, phone in rows:
                name = name or ""
                phone = phone or ""
                by_id[contact_id] = (name, phone)
                if phone and "•" not in phone:
                    by_phone[digits_of(phone)].append((name or phone, contact_id))
            try:
                self_ids = {row[0] for row in con.execute('SELECT id FROM contacts2 WHERE isSelf=1')}
            except sqlite3.OperationalError:
                pass  # Older caches and fixtures have no self flag.
        finally:
            con.close()
    except sqlite3.Error:
        pass  # locked or unreadable cache: fall back to raw ids
    return {"by_id": by_id, "by_phone": by_phone, "self_ids": self_ids}


def load_all_contacts(appdir, directory):
    result = {}
    if not appdir:
        return result
    for path in glob.glob(os.path.join(directory, "history.*.jsonl")):
        profile = decode_profile(os.path.basename(path))
        result[profile] = load_contacts(appdir, profile)
    return result


def decode_profile(filename):
    base = filename.rsplit("history.", 1)[1].rsplit(".jsonl", 1)[0]
    try:
        return bytes.fromhex(base).decode("utf-8", errors="replace")
    except ValueError:
        return base


def fmt(ms):
    try:
        aware = datetime.datetime.fromtimestamp(ms / 1000).astimezone()
        return aware.strftime("%Y-%m-%d %H:%M:%S %z")
    except (OverflowError, OSError, ValueError):
        return "invalid time"


def seen_text(seen):
    if seen in (-1, 0, None):
        return "hidden/unknown"
    if seen == 1:
        return "last month"
    if seen == 2:
        return "last week"
    return fmt(seen)


def status_text(record):
    """One shared formatter for a sample record's state."""
    if record.get("on"):
        return "online"
    if record.get("recent"):
        return "seen recently"
    return "offline, seen " + seen_text(record.get("seen", -1))


def observable(record):
    """The producer's observable-data predicate: clears hidden state."""
    return bool(record.get("on")) or record.get("seen", -1) >= 0 or bool(record.get("recent"))


def parse_when(text):
    if not text:
        return None
    value = text.strip()
    if value.endswith("Z"):
        value = value[:-1] + "+00:00"
    parsed = None
    for candidate in (value, value + "T00:00:00"):
        try:
            parsed = datetime.datetime.fromisoformat(candidate)
            break
        except ValueError:
            parsed = None
    if parsed is None:
        sys.exit("cannot parse time %r (use YYYY-MM-DD or YYYY-MM-DD HH:MM)" % text)
    try:
        if parsed.tzinfo is None:
            parsed = parsed.astimezone()
        return int(parsed.timestamp() * 1000)
    except (OverflowError, OSError, ValueError):
        sys.exit("cannot parse time %r (use YYYY-MM-DD or YYYY-MM-DD HH:MM)" % text)


def valid_record(record):
    """Full schema validation: anything else is skipped with a warning."""
    if not isinstance(record, dict):
        return False
    ts = record.get("ts")
    uid = record.get("u")
    if not isinstance(ts, int) or isinstance(ts, bool) or ts <= 0:
        return False
    if ts > MAX_RECORD_TS:
        return False  # implausible timestamp (beyond year 2286)
    if not isinstance(uid, str) or not uid:
        return False
    if record.get("mark") == "hidden":
        return True
    if record.get("mark") is not None:
        return False  # unknown marker kinds are rejected
    on = record.get("on")
    if not isinstance(on, int) or isinstance(on, bool) or on not in (0, 1):
        return False
    seen = record.get("seen", -1)
    if not isinstance(seen, int) or isinstance(seen, bool):
        return False
    if seen not in (-1, 0, 1, 2) and not (0 < seen <= MAX_RECORD_TS):
        return False
    recent = record.get("recent", 0)
    if not isinstance(recent, int) or isinstance(recent, bool) or recent not in (0, 1):
        return False
    hb = record.get("hb", 0)
    if not isinstance(hb, int) or isinstance(hb, bool) or hb not in (0, 1):
        return False
    return True


def list_history_files(directory):
    """List history files, surfacing enumeration failures as warnings."""
    if not os.path.isdir(directory):
        sys.exit("no presence directory at %s" % directory)
    try:
        names = sorted(os.listdir(directory))
    except OSError as exc:
        warn("cannot list %s: %s" % (directory, exc))
        return []
    return [os.path.join(directory, name) for name in names
            if name.startswith("history.") and name.endswith(".jsonl")]


def iter_records(directory, profile_filter=None, since=None, until=None):
    for path in list_history_files(directory):
        profile = decode_profile(os.path.basename(path))
        if profile_filter and profile_filter not in profile:
            continue
        try:
            fh = open(path, "rb")
        except OSError as exc:
            warn("cannot read %s: %s" % (path, exc))
            continue
        try:
            for line_number, raw in enumerate(fh, 1):
                try:
                    line = raw.decode("utf-8").strip()
                except UnicodeDecodeError:
                    warn("%s:%d is not valid UTF-8; skipping" % (path, line_number))
                    continue
                if not line:
                    continue
                try:
                    record = json.loads(line)
                except (json.JSONDecodeError, ValueError, RecursionError):
                    continue  # torn tail or pathological nesting
                if not valid_record(record):
                    warn("skipping malformed record in %s:%d" % (path, line_number))
                    continue
                # Date bounds apply to every record kind, markers included.
                if since is not None and record["ts"] < since:
                    continue
                if until is not None and record["ts"] > until:
                    continue
                yield profile, record
        except OSError as exc:
            warn("error while reading %s: %s" % (path, exc))
        finally:
            fh.close()


def normalize_uid(profile, uid):
    # Telegram user ids are stored hex-encoded (ASCII of the numeric id).
    if profile.startswith("Telegram") and uid and all(c in "0123456789abcdef" for c in uid):
        try:
            return bytes.fromhex(uid).decode("ascii")
        except (ValueError, UnicodeDecodeError):
            pass
    return uid


def short_id(uid):
    """Unambiguous short form: phone JIDs lose their suffix, LIDs keep it."""
    if uid.endswith("@s.whatsapp.net"):
        return uid[: -len("@s.whatsapp.net")]
    if uid.endswith("@newsletter") or uid.endswith("@broadcast"):
        return uid[: -len("@newsletter")]
    return uid  # LIDs and other ids stay fully qualified


def digits_of(value):
    return "".join(c for c in value if c.isdigit())


def resolve_name(profile, uid, contacts):
    entry = contacts.get("by_id", {}).get(uid)
    if entry:
        name, phone = entry
        if name:
            return name, phone
    if profile.startswith("Telegram"):
        return (entry[0] or entry[1], entry[1]) if entry else (None, "")
    # Phone fallback: only genuine phone JIDs, and only through complete,
    # unmasked cached phone values (never LID digits).
    if uid.endswith("@s.whatsapp.net"):
        phone_digits = digits_of(uid)
        matches = [name for name, _ in contacts.get("by_phone", {}).get(phone_digits, [])]
        if len(matches) == 1:
            return matches[0], phone_digits
    return None, ""


def identity_parts(profile, uid, contacts_by_profile, args):
    """Return (name-or-empty, unambiguous id text)."""
    id_text = normalize_uid(profile, uid) if profile.startswith("Telegram") else short_id(uid)
    name = ""
    if not args.no_names:
        name, _ = resolve_name(profile, uid, contacts_by_profile.get(profile, {}))
    return (name or ""), id_text


def display_id(profile, uid, contacts_by_profile, args):
    name, id_text = identity_parts(profile, uid, contacts_by_profile, args)
    if name:
        return clean("%s <%s>" % (name, id_text))
    return clean(id_text)


def pattern_matches(profile, uid, pattern, contacts_by_profile, args, resolution_cache):
    pattern = pattern.casefold()
    if pattern in uid.casefold() or pattern in normalize_uid(profile, uid).casefold():
        return True
    if pattern in short_id(uid).casefold():
        return True
    if args.no_names:
        return False
    name, phone = resolution_cache.get((profile, uid), (None, None))
    if name is None and (profile, uid) not in resolution_cache:
        name, phone = resolve_name(profile, uid, contacts_by_profile.get(profile, {}))
        resolution_cache[(profile, uid)] = (name, phone)
    if name and pattern in name.casefold():
        return True
    if phone and pattern in phone.casefold():
        return True
    return False


def aggregate(directory, profile_filter, since, until, pattern, contacts, args):
    """One pass over the history: per-contact aggregates. The displayed
    state follows every genuine sample; the hidden lifecycle is tracked in
    append order (immune to wall-clock rollbacks), and only observable
    samples retire a hidden mark."""
    stats = {}
    resolution_cache = {}
    for profile, record in iter_records(directory, profile_filter, since, until):
        uid = record["u"]
        if pattern and not pattern_matches(profile, uid, pattern, contacts, args,
                                           resolution_cache):
            continue
        key = (profile, uid)
        s = stats.get(key)
        if s is None:
            s = stats[key] = {"count": 0, "online": 0, "heartbeats": 0,
                              "last_ts": 0, "first_obs_ts": 0,
                              "last_state": None, "hidden_order": 0, "obs_order": 0,
                              "order": 0, "hidden_ts": 0}
        s["order"] += 1
        order = s["order"]
        if record.get("mark") == "hidden":
            s["hidden_order"] = order
            s["hidden_ts"] = max(s["hidden_ts"], record["ts"])
        elif record.get("hb"):
            s["heartbeats"] += 1
        else:
            s["count"] += 1
            if record.get("on"):
                s["online"] += 1
            # The displayed state follows every genuine sample, even
            # no-data ones (an offline sample after online must not leave
            # the contact displayed as online).
            s["last_state"] = status_text(record)
            if observable(record):
                s["obs_order"] = order
                if s["first_obs_ts"] == 0:
                    s["first_obs_ts"] = record["ts"]
        if record["ts"] > s["last_ts"]:
            s["last_ts"] = record["ts"]
    return stats


def skipped_state(s):
    """Hidden, unless an observable sample arrived after the marker in
    append order."""
    if s["hidden_order"] == 0:
        return False
    return s["obs_order"] < s["hidden_order"]


def cell(text, width):
    """Plain truncation with an ellipsis (no '<id>' awareness)."""
    if len(text) <= width:
        return text.ljust(width)
    return (text[: width - 1] + "…").ljust(width)


def name_id_cell(name, id_text, width):
    """Truncate the display NAME only; the '<id>' suffix is always kept
    intact."""
    if name:
        suffix = " <%s>" % id_text
        if len(suffix) >= width:
            return (suffix[: width - 1] + "…").ljust(width) if width > 1 else suffix[:width].ljust(width)
        available = width - len(suffix)
        head = name[:available]
        if len(name) > available:
            head += "…"
        return (head + suffix).ljust(width)
    return cell(id_text, width)


def raw_display_id(profile, uid, contacts_by_profile, args):
    """Unescaped display form, for width computation before cleaning."""
    name, id_text = identity_parts(profile, uid, contacts_by_profile, args)
    if name:
        return "%s <%s>" % (name, id_text)
    return id_text


def cmd_list(args):
    since = parse_when(args.since)
    until = parse_when(args.until)
    contacts = {} if args.no_names else load_all_contacts(args.appdir, args.dir)
    stats = aggregate(args.dir, args.profile, since, until, args.pattern, contacts, args)
    if not stats:
        if args.pattern:
            sys.exit("no records match %r" % args.pattern)
        print("no presence history found")
        return
    rows = []
    for (profile, uid), s in sorted(stats.items(), key=lambda kv: -kv[1]["last_ts"]):
        if skipped_state(s):
            state = "skipped (hidden)"
        elif s["last_state"] is not None:
            state = s["last_state"]
        else:
            state = "unknown"
        name, id_text = identity_parts(profile, uid, contacts, args)
        rows.append((clean(profile), name, id_text, fmt(s["last_ts"]), state,
                     s["count"], s["online"], s["heartbeats"]))
    profile_width = min(max((len(r[0]) for r in rows), default=12) + 2, 28)
    name_width = min(max((len(name_id_cell(r[1], r[2], 60)) for r in rows), default=12) + 2, 44)
    for profile, name, id_text, last, state, count, online, heartbeats in rows:
        print("%s%s%s  %s  (%d samples, %d online, %d heartbeats)"
              % (cell(profile, profile_width),
                 clean(name_id_cell(name, id_text, name_width - 1)), last,
                 state, count, online, heartbeats))


def current_contacts(args):
    """Keep only each contact's last reported state. Heartbeats aren't observations."""
    if not os.path.isdir(args.dir):
        return []
    contacts = {} if args.no_names else load_all_contacts(args.appdir, args.dir)
    latest = {}
    for profile, record in iter_records(args.dir, args.profile):
        if record.get("hb"):
            continue
        key = (profile, record["u"])
        item = latest.setdefault(key, {"key": key, "record": None, "hidden": False})
        if record.get("mark") == "hidden":
            item["hidden"] = True
        else:
            item["record"] = record
            if observable(record):
                item["hidden"] = False
    for (profile, uid), item in latest.items():
        item.update(current_identity(profile, uid, contacts, args))
    return sorted(latest.values(), key=lambda item: (item["service"], item["name"].casefold(), item["key"]))


def current_identity(profile, uid, contacts, args):
    name, identifier = identity_parts(profile, uid, contacts, args)
    service = 'WhatsApp' if profile.startswith('WhatsApp') else 'Telegram' if profile.startswith('Telegram') else 'Other'
    named = bool(name.strip()) and name not in (uid, identifier)
    _, phone = resolve_name(profile, uid, contacts.get(profile, {}))
    if service == 'WhatsApp' and uid.endswith('@s.whatsapp.net'):
        phone = uid[:-len('@s.whatsapp.net')]
    if not named:
        name = '+' + identifier if uid.endswith('@s.whatsapp.net') else 'Contact ' + identifier
    return dict(name=clean(name.strip()), identifier=clean(identifier), service=service,
                phone=contact_phone(phone), named=named)


def private_contact(profile, uid, book):
    if uid in book.get('self_ids', set()):
        return False
    if profile.startswith('WhatsApp'):
        return uid.endswith(('@s.whatsapp.net', '@lid'))
    if profile.startswith('Telegram'):
        identifier = normalize_uid(profile, uid)
        return identifier.isascii() and identifier.isdigit() and int(identifier) > 0
    return False


def contact_phone(value):
    """Use complete international numbers without guessing a region or LID alias."""
    value = value.strip()
    if not value or any(char not in '+0123456789-(). \t' for char in value):
        return ''
    if value.count('+') > 1 or ('+' in value and not value.startswith('+')):
        return ''
    digits = ''.join(char for char in value if char in '0123456789')
    if digits.startswith('00'):
        digits = digits[2:]
    return digits if 7 <= len(digits) <= 15 and not digits.startswith('0') else ''


def contact_link_pair(pair):
    if not isinstance(pair, (list, tuple)) or len(pair) != 2:
        raise ValueError('Invalid local contact link')
    for identity in pair:
        if not isinstance(identity, (list, tuple)) or len(identity) != 2 or any(
                not isinstance(value, str) or not value or len(value) > 512 or '\x00' in value
                for value in identity):
            raise ValueError('Invalid local contact identity')
    return tuple(tuple(identity) for identity in pair)


def read_contact_links(args):
    path = os.path.join(args.appdir, 'presence-contact-links.json')
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        return []
    with os.fdopen(fd, 'rb') as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077 or info.st_size > 1_048_576:
            raise ValueError('Local contact links need a private regular file')
        try:
            data = json.load(stream)
        except (ValueError, UnicodeError, RecursionError) as error:
            raise ValueError('Local contact links could not be read') from error
    if not isinstance(data, dict) or type(data.get('version')) is not int or data['version'] != 1 or not isinstance(data.get('links'), list) or len(data['links']) > 1000:
        raise ValueError('Local contact links have an unsupported format')
    return [contact_link_pair(pair) for pair in data['links']]


def save_contact_link(args, pair=None, remove=()):
    """Merge private display preferences under a lock and replace atomically."""
    if pair is not None:
        pair = contact_link_pair(pair)
    os.makedirs(args.appdir, mode=0o700, exist_ok=True)
    lock_path = os.path.join(args.appdir, 'presence-contact-links.lock')
    fd = os.open(lock_path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'a') as lock:
        info = os.fstat(lock.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
            raise ValueError('Local contact link lock must be private')
        fcntl.flock(lock, fcntl.LOCK_EX)
        links = read_contact_links(args)
        removed = set(remove)
        links = [link for link in links if not removed.intersection(link)]
        if pair and tuple(pair) not in links and tuple(reversed(pair)) not in links:
            links.append(tuple(pair))
        if len(links) > 1000:
            raise ValueError('Too many local contact links')
        output_fd, temporary = tempfile.mkstemp(prefix='.presence-contact-links-', dir=args.appdir)
        try:
            with os.fdopen(output_fd, 'w') as output:
                json.dump({'version': 1, 'links': links}, output)
                output.write('\n')
                output.flush()
                os.fsync(output.fileno())
            os.replace(temporary, os.path.join(args.appdir, 'presence-contact-links.json'))
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)


def current_people(args, include_cached=False):
    contacts = list(current_contacts(args))
    try:
        links = read_contact_links(args)
    except (OSError, ValueError) as error:
        warn(str(error) + '. Showing automatic matches.')
        links = []
    wanted = {identity for pair in links for identity in pair}
    present = {item['key'] for item in contacts}
    if include_cached or wanted - present:
        books = {}
        profiles = {identity[0] for identity in wanted - present}
        if include_cached:
            history = Path(args.appdir) / 'history'
            if history.is_dir():
                profiles.update(folder.name for folder in history.iterdir()
                                if folder.is_dir() and folder.name.startswith(('Telegram_', 'WhatsAppMd_')))
        for profile in profiles:
            books[profile] = load_contacts(args.appdir, profile)
        for profile, book in books.items():
            for uid in book['by_id']:
                key = (profile, uid)
                if key in present or (not include_cached and key not in wanted) or not private_contact(profile, uid, book):
                    continue
                item = dict(key=key, record=None, hidden=False)
                item.update(current_identity(profile, uid, books, args))
                contacts.append(item)
                present.add(key)
    parents = {item['key']: item['key'] for item in contacts}
    for pair in links:
        for key in pair:
            parents.setdefault(key, key)

    def root(key):
        while parents[key] != key:
            parents[key] = parents[parents[key]]
            key = parents[key]
        return key

    def join(left, right):
        parents[root(right)] = root(left)

    known = {}
    for item in contacts:
        identifiers = [('id', item['service'], normalize_uid(*item['key']))]
        if item['phone']:
            identifiers.append(('phone', item['phone']))
        for identity in identifiers:
            if identity in known:
                join(known[identity], item['key'])
            else:
                known[identity] = item['key']
    for left, right in links:
        join(left, right)
    groups = collections.defaultdict(list)
    for item in contacts:
        groups[root(item['key'])].append(item)
    manual_roots = {root(pair[0]) for pair in links}
    people = []
    for key, members in groups.items():
        members.sort(key=lambda item: item['key'])
        preferred = max(members, key=lambda item: (item['named'], len(item['name'].split()), len(item['name'])))
        people.append({'key': tuple(item['key'] for item in members), 'name': preferred['name'],
                       'members': members, 'manual': key in manual_roots})
    return sorted(people, key=lambda item: (item['name'].casefold(), item['key']))


def service_contact(person, service):
    candidates = [member for member in person['members'] if member['service'] == service]
    return max(candidates, key=lambda item: item['record']['ts'] if item['record'] else 0, default=None)


def report_age(timestamp, now):
    if not timestamp:
        return "No report"
    if timestamp > now + 60_000:
        return "Clock mismatch"
    seconds = max(0, (now - timestamp) // 1000)
    if seconds < 60:
        return "Just now"
    if seconds < 3600:
        return "%dm ago" % (seconds // 60)
    if seconds < 86400:
        return "%dh ago" % (seconds // 3600)
    return "%dd ago" % (seconds // 86400)


def readable_seen(timestamp, now):
    if timestamp in (None, -1, 0):
        return "Unavailable"
    if timestamp == 1:
        return "Within last month"
    if timestamp == 2:
        return "Within last week"
    seen = datetime.datetime.fromtimestamp(timestamp / 1000).astimezone()
    today = datetime.datetime.fromtimestamp(now / 1000).astimezone().date()
    if seen.date() == today:
        return "Today " + seen.strftime("%H:%M")
    if seen.date() == today - datetime.timedelta(days=1):
        return "Yesterday " + seen.strftime("%H:%M")
    return seen.strftime("%d %b %Y, %H:%M")


def readable_report(timestamp):
    return datetime.datetime.fromtimestamp(timestamp / 1000).astimezone().strftime('%a %d %b, %H:%M:%S %Z')


def current_fields(item, now):
    record = item["record"]
    if item["hidden"]:
        return "Unavailable", "Unavailable", "No fresh report"
    if record is None:
        return 'No report', 'Unavailable', 'No report'
    age = report_age(record["ts"], now)
    if age == "Clock mismatch":
        return "Unconfirmed", "Unavailable", age
    fresh = 0 <= now - record["ts"] <= 300_000
    if record.get("on"):
        # A cached heartbeat cannot renew an online claim.
        state = "Online" if fresh else "Unconfirmed"
        return state, "—", age
    if record.get("recent"):
        return ("Seen recently" if fresh else "Approx. (old)"), "Seen recently", age
    if record.get("seen", -1) <= 0:
        return "Unavailable", "Unavailable", age
    return ("Offline" if fresh else "Offline (old)"), readable_seen(record["seen"], now), age


_libc = ctypes.CDLL(ctypes.util.find_library("c") or None)
_libc.wcwidth.argtypes = [ctypes.c_wchar]
_libc.wcwidth.restype = ctypes.c_int


def screen_text(text):
    """Use stable terminal cells for emoji modifiers, joiners and flag pairs."""
    text = clean(str(text))
    result = []
    for char in text:
        code = ord(char)
        if 0x1F1E6 <= code <= 0x1F1FF:
            result.append(chr(ord('A') + code - 0x1F1E6))
        elif 0x1F3FB <= code <= 0x1F3FF or char in ('\ufe0f', '\ufe0e'):
            continue
        elif char == '\u200d':
            result.append(' ')
        else:
            result.append(char)
    return ''.join(result)


def fit_screen(text, width):
    """Clip by terminal cells, retaining accents attached to the last base."""
    text = screen_text(text)
    if width <= 0:
        return ""
    if sum(max(0, _libc.wcwidth(char)) for char in text) <= width:
        return text
    result = []
    used = 0
    for char in text:
        cells = max(0, _libc.wcwidth(char))
        if used + cells > width - 1:
            break
        result.append(char)
        used += cells
    return ''.join(result) + '…'


def search_text(value):
    return ' '.join(unicodedata.normalize('NFKC', value).casefold().split())


def current_rows(contacts, query, service):
    query = search_text(query)
    number = ''.join(char for char in query if char in '0123456789')
    number_query = number and all(char in '+0123456789-(). ' for char in query)
    rows = []
    for person in contacts:
        if service != 'All' and service_contact(person, service) is None:
            continue
        values = [person['name']]
        for item in person['members']:
            values.extend((item['name'], item['identifier'], item['phone']))
        text_match = query in search_text(' '.join(values))
        phone_match = number_query and any(
            number in ''.join(char for char in value if char in '0123456789')
            for item in person['members'] for value in (item['identifier'], item['phone']))
        if text_match or phone_match:
            rows.append(person)
    return rows


def pad_screen(text, width):
    text = fit_screen(text, width)
    return text + ' ' * max(0, width - sum(max(0, _libc.wcwidth(char)) for char in text))


def person_columns(width):
    available = width - 8
    name = min(32, available // 3)
    telegram = (available - name) // 2
    return name, telegram, available - name - telegram


def current_heading(width):
    if width < 44:
        return ' CONTACT · TG / WA'
    return '  ' + ' │ '.join(pad_screen(label, size) for label, size in
                            zip(('CONTACT', 'TELEGRAM', 'WHATSAPP'), person_columns(width)))


def service_summary(person, service, now, width):
    item = service_contact(person, service)
    if item is None:
        return '—'
    state, seen, age = current_fields(item, now)
    if state == 'Offline':
        text = 'Seen ' + seen
    elif state == 'Offline (old)':
        text = 'Old · ' + seen
    elif state in ('Unavailable', 'No report'):
        return state
    else:
        text = state + ' · ' + age
    if width >= 36 and state.startswith('Offline'):
        text += ' · ' + age
    return text


def current_lines(contacts, width, now):
    lines = []
    for person in contacts:
        if width >= 44:
            sizes = person_columns(width)
            values = (person['name'], service_summary(person, 'Telegram', now, sizes[1]),
                      service_summary(person, 'WhatsApp', now, sizes[2]))
            text = '  ' + ' │ '.join(pad_screen(value, size) for value, size in zip(values, sizes))
            lines.append((text, person['key'], 'person'))
        else:
            lines.append(('  ' + person['name'], person['key'], 'person'))
            for service, label in [('Telegram', 'TG'), ('WhatsApp', 'WA')]:
                text = '    ' + label + ' ' + service_summary(person, service, now, width - 7)
                lines.append((text, person['key'], 'person'))
    return lines


def print_current(args):
    now = int(time.time() * 1000)
    rows = current_rows(current_people(args), args.pattern, 'All')
    print('NCHAT  ·  Latest reported status')
    print('Local cache  ·  ' + datetime.datetime.now().astimezone().strftime('%d %b %Y %H:%M %Z'))
    print('Reports older than 5 minutes are labelled old or unconfirmed.\n')
    if not rows:
        print('No contacts match.' if args.pattern else 'No status reports available yet.')
        return
    print(current_heading(100))
    for text, _, _ in current_lines(rows, 100, now):
        print(fit_screen(text, 100))


def person_history(person, args, per_service=500):
    """Merged chronological history for a person: one entry per record
    across all of their service accounts, newest last."""
    records = []
    for member in person['members']:
        profile, uid = member['key']
        collected = [record for _, record in iter_records(args.dir, profile)
                     if record['u'] == uid]
        for record in collected[-per_service:]:
            records.append((record['ts'], member['service'], record))
    records.sort(key=lambda item: item[0])
    return [{'ts': ts, 'service': service, 'record': record}
            for ts, service, record in records]


def history_line(entry):
    record = entry['record']
    label = 'TG' if entry['service'] == 'Telegram' else 'WA'
    if record.get('mark') == 'hidden':
        state = 'marked hidden (skipped)'
    elif record.get('hb'):
        state = '~ ' + status_text(record)
    else:
        state = status_text(record)
    return '%s  [%s]  %s' % (fmt(record['ts']), label, state)


def browse_person(win, args, person):
    import curses
    history = person_history(person, args)
    query, searching, scroll = '', False, 0

    def put(y, text, attribute=0):
        if 0 <= y < height and width > 1:
            try:
                win.addstr(y, 0, fit_screen(text, width - 1), attribute)
            except curses.error:
                pass  # A terminal resize can race drawing.

    while True:
        rows = history
        if query:
            needle = query.casefold()
            rows = [entry for entry in history
                    if needle in history_line(entry).casefold()]
        height, width = win.getmaxyx()
        scroll = max(0, min(scroll, max(0, len(rows) - (height - 7))))
        win.erase()
        now = int(time.time() * 1000)
        put(0, ' ' + person['name'] + '  ·  History', curses.A_BOLD)
        summary = []
        for platform in ('Telegram', 'WhatsApp'):
            item = service_contact(person, platform)
            if item:
                state, seen, age = current_fields(item, now)
                summary.append(platform + ': ' + state + ' · seen ' + seen)
        put(1, ' ' + ('  ·  '.join(summary) if summary else 'No status records for this contact'))
        put(2, ' ' + ('/' + query + ('_' if searching else '')), curses.A_REVERSE if searching else 0)
        put(3, ' Most recent records last' if not rows or not query else ' %d matching records' % len(rows),
            curses.A_DIM)
        for i, entry in enumerate(rows[scroll:scroll + (height - 7)]):
            put(4 + i, ' ' + history_line(entry))
        if not rows:
            put(5, ' No records for this person.')
        put(height - 3, ' ↑↓/j k Scroll  / Search', curses.A_DIM)
        put(height - 2, ' PgUp/PgDn Page  g/G Ends')
        put(height - 1, ' q/Esc Back to list')
        win.refresh()
        try:
            key = win.get_wch()
        except curses.error:
            continue
        if key == curses.KEY_RESIZE:
            continue
        if searching:
            if key in ('\n', '\r', curses.KEY_ENTER):
                searching = False
            elif key in ('\x1b', '\x03'):
                query, searching = '', False
            elif key in ('\x7f', '\b', curses.KEY_BACKSPACE):
                query = query[:-1]
            elif isinstance(key, str) and key.isprintable() and len(query) < 120:
                query += key
            scroll = 0
        elif key in ('q', 'Q', '\x1b', '\x03'):
            return
        elif key in (curses.KEY_DOWN, 'j'):
            scroll += 1
        elif key in (curses.KEY_UP, 'k'):
            scroll = max(0, scroll - 1)
        elif key in (curses.KEY_NPAGE, curses.KEY_PPAGE):
            page = max(1, height - 7)
            scroll = max(0, scroll + (page if key == curses.KEY_NPAGE else -page))
        elif key in ('g', curses.KEY_HOME):
            scroll = 0
        elif key in ('G', curses.KEY_END):
            scroll = max(0, len(rows) - (height - 7))
        elif key == '/':
            searching = True


def pick_person_link(win, source, people):
    import curses
    services = {item['service'] for item in source['members']}
    candidates = []
    for person in people:
        members = [item for item in person['members'] if item['service'] in {'Telegram', 'WhatsApp'} - services]
        if members:
            preferred = max(members, key=lambda item: (item['named'], len(item['name'].split()), len(item['name'])))
            candidates.append(dict(person, name=preferred['name'], members=members,
                                   key=tuple(item['key'] for item in members)))
    names = {search_text(item['name']) for item in source['members']}
    candidates.sort(key=lambda person: (not any(search_text(item['name']) in names
                                               for item in person['members']), person['name'].casefold()))
    query, selected, top = '', 0, 0
    while True:
        height, width = win.getmaxyx()
        rows = current_rows(candidates, query, 'All')
        selected = min(selected, max(0, len(rows) - 1))
        page = max(1, height - 6)
        top = max(0, min(top, selected, max(0, len(rows) - page)))
        if selected >= top + page:
            top = selected - page + 1
        win.erase()
        content = [(0, 'Link ' + source['name'], curses.A_BOLD),
                   (1, 'Type a name or number, then choose the same person', 0),
                   (2, 'Search name/number  ' + query + '_', curses.A_REVERSE)]
        for index, person in enumerate(rows[top:top + page], top):
            item = person['members'][0]
            content.append((4 + index - top, person['name'] + ' · ' + item['identifier'],
                            curses.A_REVERSE if index == selected else 0))
        if not rows:
            content.append((4, 'No matching contact. Esc cancels.', 0))
        content.extend([(height - 2, '↑↓ Choose  Enter Link', 0),
                        (height - 1, 'Type to search  Esc Cancel', 0)])
        for y, text, attribute in content:
            if 0 <= y < height and width > 1:
                try:
                    win.addstr(y, 0, fit_screen(text, width - 1), attribute)
                except curses.error:
                    pass
        win.refresh()
        try:
            key = win.get_wch()
        except curses.error:
            continue
        if key == curses.KEY_RESIZE:
            continue
        if key in ('\x1b', '\x03'):
            return None
        elif key in ('\n', '\r', curses.KEY_ENTER) and rows:
            return rows[selected]
        elif key == curses.KEY_DOWN:
            selected += 1
        elif key == curses.KEY_UP:
            selected = max(0, selected - 1)
        elif key in (curses.KEY_NPAGE, curses.KEY_PPAGE):
            selected = max(0, selected + (page if key == curses.KEY_NPAGE else -page))
        elif key == curses.KEY_HOME:
            selected = 0
        elif key == curses.KEY_END:
            selected = max(0, len(rows) - 1)
        elif key in ('\x7f', '\b', curses.KEY_BACKSPACE):
            query = query[:-1]
            selected, top = 0, 0
        elif key == '\x06':
            query, selected, top = '', 0, 0
        elif key == '/' and not query:
            continue
        elif isinstance(key, str) and key.isprintable() and len(query) < 120:
            query += key
            selected, top = 0, 0


def browse_current(win, args):
    import curses
    if hasattr(curses, 'set_escdelay') and 'ESCDELAY' not in os.environ:
        curses.set_escdelay(50)
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    win.keypad(True)
    win.timeout(1000)
    errors = io.StringIO()
    with contextlib.redirect_stderr(errors):
        contacts = current_people(args)
    query, service, searching, selection, top = args.pattern, 'All', False, 0, 0
    loaded_at = datetime.datetime.now().astimezone()
    note = ('Some cache records could not be read. r retries.' if errors.getvalue()
            else 'm links contacts · u removes manual links · r refreshes')
    while True:
        rows = current_rows(contacts, query, service)
        selection = min(selection, max(0, len(rows) - 1))
        selected = rows[selection]['key'] if rows else None
        height, width = win.getmaxyx()
        now = int(time.time() * 1000)
        lines = current_lines(rows, max(1, width - 1), now)
        row_height = 3 if width < 45 else 1
        page = max(row_height, (height - 10) // row_height * row_height)
        selected_line = next((i for i, line in enumerate(lines) if line[1] == selected), 0)
        if selected_line < top:
            top = max(0, selected_line - 1)
        selected_end = max((i for i, line in enumerate(lines) if line[1] == selected), default=selected_line)
        if selected_end >= top + page:
            top = selected_end - page + 1
        top = max(0, min(top, max(0, len(lines) - page)))
        top -= top % row_height
        win.erase()

        def put(y, text, attribute=0):
            if 0 <= y < height and width > 1:
                try:
                    win.addstr(y, 0, fit_screen(text, width - 1), attribute)
                except curses.error:
                    pass  # A terminal resize can race drawing.

        put(0, ' NCHAT  /  Latest status', curses.A_BOLD)
        put(1, ' Read at ' + loaded_at.strftime('%H:%M %Z') + '  ·  ' + str(len(rows)) + ' people · >5m = old')
        label = 'SEARCH name/number  ' + query + '_' if searching else (
            ('ALL PEOPLE' if service == 'All' else 'WITH ' + service.upper()) + ' · ' +
            ('Find ' + query if query else '/ or Ctrl+F to search names/numbers'))
        put(2, ' ' + label, curses.A_REVERSE)
        put(3, current_heading(width - 1), curses.A_BOLD)
        for i, (text, key, _) in enumerate(lines[top:top + page]):
            attribute = 0
            if key is not None and key == selected:
                attribute |= curses.A_REVERSE
                if top + i == selected_line:
                    text = '› ' + text[2:]
            put(4 + i, text, attribute)
        if not rows:
            put(5, ' No contacts match. Esc clears search; Tab changes service.' if query or service != 'All' else ' No status reports available yet.')
        if rows and height >= 12:
            person = rows[selection]
            match = 'Linked by you' if person['manual'] else 'Phone/account match' if len(person['members']) > 1 else 'Single service'
            put(height - 6, ' ' + person['name'] + ' · ' + match, curses.A_BOLD)
            for offset, platform in enumerate(('Telegram', 'WhatsApp')):
                item = service_contact(person, platform)
                detail = platform + ' — no contact in this view'
                if item:
                    state, seen, age = current_fields(item, now)
                    detail = platform + ' ' + item['identifier'] + ' · ' + state + ' · seen ' + seen + ' · report ' + age
                    if width >= 120 and item['record']:
                        detail += ' · ' + readable_report(item['record']['ts'])
                    others = sum(value['service'] == platform for value in person['members']) - 1
                    if others:
                        detail += ' · +' + str(others) + ' accounts'
                put(height - 5 + offset, ' ' + detail)
        put(height - 3, ' ' + note, curses.A_DIM)
        if width < 72:
            put(height - 2, ' / Find name/number  Enter History')
            put(height - 1, ' q Quit  r Refresh  m Link  u Unlink')
        else:
            put(height - 2, ' / Ctrl+F Find name/number  Tab Filter  Enter History')
            put(height - 1, ' q Quit  Esc Clear  r Refresh  m Link  u Unlink  PgUp/PgDn Page  g/G Ends')
        if height < (13 if width < 45 else 12) or width < 26:
            win.erase()
            put(0, 'q Quit · Enlarge terminal')
        win.refresh()
        try:
            key = win.get_wch()
        except curses.error:
            continue
        if key == curses.KEY_RESIZE:
            continue
        if searching:
            if key in (curses.KEY_DOWN, curses.KEY_UP, curses.KEY_NPAGE, curses.KEY_PPAGE):
                searching = False
            elif key in ('\n', '\r', curses.KEY_ENTER):
                searching = False
                continue
            elif key in ('\x1b', '\x03'):
                query, searching = '', False
                selection, top = 0, 0
                continue
            elif key in ('\x7f', '\b', curses.KEY_BACKSPACE):
                query = query[:-1]
                selection, top = 0, 0
                continue
            elif isinstance(key, str) and key.isprintable() and len(query) < 120:
                query += key
                selection, top = 0, 0
                continue
            else:
                continue
        if key in ('q', 'Q', '\x03'):
            return
        if key in (curses.KEY_DOWN, 'j'):
            selection += 1
        elif key in (curses.KEY_UP, 'k'):
            selection = max(0, selection - 1)
        elif key in (curses.KEY_NPAGE, curses.KEY_PPAGE):
            selection = max(0, selection + (1 if key == curses.KEY_NPAGE else -1) * max(1, page // row_height))
        elif key in ('g', curses.KEY_HOME):
            selection = 0
        elif key in ('G', curses.KEY_END):
            selection = max(0, len(rows) - 1)
        elif key == '\t':
            services = ['All', 'WhatsApp', 'Telegram']
            service = services[(services.index(service) + 1) % len(services)]
            selection, top = 0, 0
        elif key in ('\n', '\r', curses.KEY_ENTER) and rows:
            browse_person(win, args, rows[selection])
            continue
        elif key in ('/', '\x06', 'f'):
            searching = True
        elif key == '\x1b':
            query, service, selection, top = '', 'All', 0, 0
        elif key in ('m', 'u') and rows:
            person = rows[selection]
            try:
                if key == 'm':
                    if all(service_contact(person, value) for value in ('Telegram', 'WhatsApp')):
                        note = 'This person already has both services'
                        continue
                    with contextlib.redirect_stderr(io.StringIO()):
                        candidates = current_people(args, include_cached=True)
                    target = pick_person_link(win, person, candidates)
                    if target is None:
                        note = 'Link cancelled'
                        continue
                    save_contact_link(args, pair=(person['members'][0]['key'], target['members'][0]['key']))
                    note = 'Contacts linked locally'
                else:
                    if not person['manual']:
                        note = 'This row has no manual links to remove'
                        continue
                    save_contact_link(args, remove=person['key'])
                    note = 'Manual links removed'
                contacts = current_people(args)
                visible = current_rows(contacts, query, service)
                anchor = person['members'][0]['key']
                selection = next((i for i, value in enumerate(visible) if anchor in value['key']), 0)
            except (OSError, ValueError):
                note = 'Could not save the local link. Check preferences and permissions.'
        elif key in ('r', 'R'):
            errors = io.StringIO()
            try:
                with contextlib.redirect_stderr(errors):
                    contacts = current_people(args)
                visible = current_rows(contacts, query, service)
                selection = next((i for i, item in enumerate(visible) if selected and set(selected).intersection(item['key'])), 0)
                loaded_at = datetime.datetime.now().astimezone()
                note = 'Refreshed ' + loaded_at.strftime('%H:%M')
                if errors.getvalue():
                    note += '  ·  Some cache records could not be read'
            except (OSError, SystemExit):
                note = 'Could not refresh the cache. Press r to retry.'


