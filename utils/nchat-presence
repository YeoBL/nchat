from pathlib import Path

PROGRAM = "nchat-presence"

# Bidi control characters and other unsafe-for-terminal code points.
_UNSAFE_RANGES = ((0x00, 0x1F), (0x7F, 0x9F), (0xD800, 0xDFFF),
                  (0x202A, 0x202E), (0x2066, 0x2069), (0x200E, 0x200F))


def default_appdir():
    """Mirror nchat's application-directory resolution (fileutil.cpp),
    plus the helper-specific NCHAT_CONFIG_DIR override."""
    env = os.environ.get("NCHAT_CONFIG_DIR")
    if env:
        return env
    home = os.environ.get("HOME", "")
    legacy = os.path.join(home, ".nchat") if home else ""
    if legacy and os.path.isdir(legacy):
        return legacy
    xdg = os.environ.get("XDG_CONFIG_HOME")
    config_home = xdg if xdg else (os.path.join(home, ".config") if home else ".config")
    return os.path.join(config_home, "nchat")


def default_dir():
    return os.path.join(default_appdir(), "presence")


def clean(text):
    """Render a string safely for a terminal: escape control, bidi and
    surrogate characters."""
    out = []
    for ch in text:
        code = ord(ch)
        if any(lo <= code <= hi for lo, hi in _UNSAFE_RANGES):
            out.append("\\u%04x" % code)
        else:
            out.append(ch)
    return "".join(out)


def warn(message):
    print("%s: warning: %s" % (PROGRAM, clean(message)), file=sys.stderr)


def load_contacts(appdir, profile):
    """Read the local nchat cache's contacts.

    Returns {"by_id": {id: (name, phone)},
             "by_phone": {digits: [(name, contact_id), ...]}}
    where masked phones (containing the bullet character) are never indexed.
    """
    by_id = {}
    by_phone = collections.defaultdict(list)
    if "/" in profile or profile in (".", ".."):
        return {"by_id": by_id, "by_phone": by_phone}
    db_path = os.path.join(appdir, "history", profile, "db.sqlite")
    if not os.path.isfile(db_path):
        return {"by_id": by_id, "by_phone": by_phone}
    uri = Path(os.path.abspath(db_path)).as_uri() + "?mode=ro"
    try:
        con = sqlite3.connect(uri, uri=True)
        try:
            rows = con.execute("SELECT id, name, phone FROM contacts2")
            for contact_id, name, phone in rows:
                name = name or ""
                phone = phone or ""
                by_id[contact_id] = (name, phone)
                if phone and "•" not in phone:
                    by_phone[digits_of(phone)].append((name or phone, contact_id))
        finally:
            con.close()
    except sqlite3.Error:
        pass  # locked or unreadable cache: fall back to raw ids
    return {"by_id": by_id, "by_phone": by_phone}


def load_all_contacts(appdir, directory):
    result = {}
    if not appdir:
        return result
    for path in glob.glob(os.path.join(directory, "history.*.jsonl")):
        profile = decode_profile(os.path.basename(path))
        result[profile] = load_contacts(appdir, profile)
    return result


def decode_profile(filename):
    base = filename.rsplit("history.", 1)[1].rsplit(".jsonl", 1)[0]
    try:
        return bytes.fromhex(base).decode("utf-8", errors="replace")
    except ValueError:
        return base


def fmt(ms):
    try:
        aware = datetime.datetime.fromtimestamp(ms / 1000).astimezone()
        return aware.strftime("%Y-%m-%d %H:%M:%S %z")
    except (OverflowError, OSError, ValueError):
        return "invalid time"


def seen_text(seen):
    if seen in (-1, 0, None):
        return "hidden/unknown"
    if seen == 1:
        return "last month"
    if seen == 2:
        return "last week"
    return fmt(seen)


def status_text(record):
    """One shared formatter for a sample record's state."""
    if record.get("on"):
        return "online"
    if record.get("recent"):
        return "seen recently"
    return "offline, seen " + seen_text(record.get("seen", -1))


def observable(record):
    """The producer's observable-data predicate: clears hidden state."""
    return bool(record.get("on")) or record.get("seen", -1) >= 0 or bool(record.get("recent"))


def parse_when(text):
    if not text:
        return None
    value = text.strip()
    if value.endswith("Z"):
        value = value[:-1] + "+00:00"
    parsed = None
    for candidate in (value, value + "T00:00:00"):
        try:
            parsed = datetime.datetime.fromisoformat(candidate)
            break
        except ValueError:
            parsed = None
    if parsed is None:
        sys.exit("cannot parse time %r (use YYYY-MM-DD or YYYY-MM-DD HH:MM)" % text)
    if parsed.tzinfo is None:
        parsed = parsed.astimezone()
    return int(parsed.timestamp() * 1000)


def valid_record(record):
    """Full schema validation: anything else is skipped with a warning."""
    if not isinstance(record, dict):
        return False
    ts = record.get("ts")
    uid = record.get("u")
    if not isinstance(ts, int) or isinstance(ts, bool) or ts <= 0:
        return False
    if not isinstance(uid, str) or not uid:
        return False
    if record.get("mark") == "hidden":
        return True
    if record.get("mark") is not None:
        return False  # unknown marker kinds are rejected
    on = record.get("on")
    if not isinstance(on, int) or isinstance(on, bool) or on not in (0, 1):
        return False
    seen = record.get("seen", -1)
    if not isinstance(seen, int) or isinstance(seen, bool):
        return False
    recent = record.get("recent", 0)
    if not isinstance(recent, int) or isinstance(recent, bool) or recent not in (0, 1):
        return False
    hb = record.get("hb", 0)
    if not isinstance(hb, int) or isinstance(hb, bool) or hb not in (0, 1):
        return False
    return True


def list_history_files(directory):
    """List history files, surfacing enumeration failures as warnings."""
    if not os.path.isdir(directory):
        sys.exit("no presence directory at %s" % directory)
    try:
        names = sorted(os.listdir(directory))
    except OSError as exc:
        warn("cannot list %s: %s" % (directory, exc))
        return []
    return [os.path.join(directory, name) for name in names
            if name.startswith("history.") and name.endswith(".jsonl")]


def iter_records(directory, profile_filter=None, since=None, until=None):
    for path in list_history_files(directory):
        profile = decode_profile(os.path.basename(path))
        if profile_filter and profile_filter not in profile:
            continue
        try:
            fh = open(path, "rb")
        except OSError as exc:
            warn("cannot read %s: %s" % (path, exc))
            continue
        try:
            for line_number, raw in enumerate(fh, 1):
                try:
                    line = raw.decode("utf-8").strip()
                except UnicodeDecodeError:
                    warn("%s:%d is not valid UTF-8; skipping" % (path, line_number))
                    continue
                if not line:
                    continue
                try:
                    record = json.loads(line)
                except (json.JSONDecodeError, ValueError):
                    continue  # torn tail being repaired by the poller
                if not valid_record(record):
                    warn("skipping malformed record in %s:%d" % (path, line_number))
                    continue
                # Date bounds apply to every record kind, markers included.
                if since is not None and record["ts"] < since:
                    continue
                if until is not None and record["ts"] > until:
                    continue
                yield profile, record
        except OSError as exc:
            warn("error while reading %s: %s" % (path, exc))
        finally:
            fh.close()


def normalize_uid(profile, uid):
    # Telegram user ids are stored hex-encoded (ASCII of the numeric id).
    if profile.startswith("Telegram") and uid and all(c in "0123456789abcdef" for c in uid):
        try:
            return bytes.fromhex(uid).decode("ascii")
        except (ValueError, UnicodeDecodeError):
            pass
    return uid


def short_id(uid):
    """Unambiguous short form: phone JIDs lose their suffix, LIDs keep it."""
    if uid.endswith("@s.whatsapp.net"):
        return uid[: -len("@s.whatsapp.net")]
    if uid.endswith("@newsletter") or uid.endswith("@broadcast"):
        return uid[: -len("@newsletter")]
    return uid  # LIDs and other ids stay fully qualified


def digits_of(value):
    return "".join(c for c in value if c.isdigit())


def resolve_name(profile, uid, contacts):
    entry = contacts.get("by_id", {}).get(uid)
    if entry:
        name, phone = entry
        if name:
            return name, phone
    if profile.startswith("Telegram"):
        return (entry[0] or entry[1], entry[1]) if entry else (None, "")
    # Phone fallback: only genuine phone JIDs, and only through complete,
    # unmasked cached phone values (never LID digits).
    if uid.endswith("@s.whatsapp.net"):
        phone_digits = digits_of(uid)
        matches = [name for name, _ in contacts.get("by_phone", {}).get(phone_digits, [])]
        if len(matches) == 1:
            return matches[0], phone_digits
    return None, ""


def identity_parts(profile, uid, contacts_by_profile, args):
    """Return (name-or-empty, unambiguous id text)."""
    id_text = normalize_uid(profile, uid) if profile.startswith("Telegram") else short_id(uid)
    name = ""
    if not args.no_names:
        name, _ = resolve_name(profile, uid, contacts_by_profile.get(profile, {}))
    return (name or ""), id_text


def display_id(profile, uid, contacts_by_profile, args):
    name, id_text = identity_parts(profile, uid, contacts_by_profile, args)
    if name:
        return clean("%s <%s>" % (name, id_text))
    return clean(id_text)


def pattern_matches(profile, uid, pattern, contacts_by_profile, args, resolution_cache):
    pattern = pattern.casefold()
    if pattern in uid.casefold() or pattern in normalize_uid(profile, uid).casefold():
        return True
    if pattern in short_id(uid).casefold():
        return True
    if args.no_names:
        return False
    name, phone = resolution_cache.get((profile, uid), (None, None))
    if name is None and (profile, uid) not in resolution_cache:
        name, phone = resolve_name(profile, uid, contacts_by_profile.get(profile, {}))
        resolution_cache[(profile, uid)] = (name, phone)
    if name and pattern in name.casefold():
        return True
    if phone and pattern in phone.casefold():
        return True
    return False


def aggregate(directory, profile_filter, since, until, pattern, contacts, args):
    """One pass over the history: per-contact aggregates with recovery-aware
    hidden state, heartbeat-separated counters and marker timestamps."""
    stats = {}
    resolution_cache = {}
    for profile, record in iter_records(directory, profile_filter, since, until):
        uid = record["u"]
        if pattern and not pattern_matches(profile, uid, pattern, contacts, args,
                                           resolution_cache):
            continue
        key = (profile, uid)
        s = stats.get(key)
        if s is None:
            s = stats[key] = {"count": 0, "online": 0, "heartbeats": 0,
                              "last_ts": 0, "first_obs_ts": 0, "last_obs_ts": 0,
                              "last_state": None, "last_seen": None, "hidden_ts": 0}
        if record.get("mark") == "hidden":
            s["hidden_ts"] = max(s["hidden_ts"], record["ts"])
        else:
            if record.get("hb"):
                s["heartbeats"] += 1
            else:
                s["count"] += 1
                if record.get("on"):
                    s["online"] += 1
                if observable(record):
                    if s["first_obs_ts"] == 0:
                        s["first_obs_ts"] = record["ts"]
                    # Only observable data defines the state; plain
                    # no-data samples neither advance it nor clear hidden.
                    if record["ts"] >= s["last_obs_ts"]:
                        s["last_obs_ts"] = record["ts"]
                        s["last_state"] = status_text(record)
                        s["last_seen"] = record.get("seen", -1)
        if record["ts"] > s["last_ts"]:
            s["last_ts"] = record["ts"]
    return stats


def skipped_state(s):
    """Hidden, unless observable data arrived after the marker."""
    if s["hidden_ts"] == 0:
        return False
    return s["last_obs_ts"] < s["hidden_ts"]


def cell(text, width):
    """Truncate a raw display string (before terminal escaping), preserving
    the '<id>' suffix when present."""
    if len(text) <= width:
        return text.ljust(width)
    marker = "<"
    cut = text.find(marker)
    if cut > 0:
        tail = text[cut:]
        head = text[:cut]
        available = width - len(tail) - 1
        if available > 0:
            return (head[:available] + "…" + tail).ljust(width)
    return (text[: width - 1] + "…").ljust(width)


def raw_display_id(profile, uid, contacts_by_profile, args):
    """Unescaped display form, for width computation before cleaning."""
    name, id_text = identity_parts(profile, uid, contacts_by_profile, args)
    if name:
        return "%s <%s>" % (name, id_text)
    return id_text


def cmd_list(args):
    since = parse_when(args.since)
    until = parse_when(args.until)
    contacts = {} if args.no_names else load_all_contacts(args.appdir, args.dir)
    stats = aggregate(args.dir, args.profile, since, until, args.pattern, contacts, args)
    if not stats:
        if args.pattern:
            sys.exit("no records match %r" % args.pattern)
        print("no presence history found")
        return
    rows = []
    for (profile, uid), s in sorted(stats.items(), key=lambda kv: -kv[1]["last_ts"]):
        if skipped_state(s):
            state = "skipped (hidden)"
        elif s["last_state"] is not None:
            state = s["last_state"]
        else:
            state = "unknown"
        rows.append((clean(profile), raw_display_id(profile, uid, contacts, args),
                     fmt(s["last_ts"]), state, s["count"], s["online"], s["heartbeats"]))
    profile_width = min(max((len(r[0]) for r in rows), default=12) + 2, 28)
    name_width = min(max((len(r[1]) for r in rows), default=12) + 2, 44)
    for profile, who, last, state, count, online, heartbeats in rows:
        print("%s%s%s  %s  (%d samples, %d online, %d heartbeats)"
              % (cell(profile, profile_width), clean(cell(who, name_width)), last,
                 state, count, online, heartbeats))


def cmd_show(args):
    since = parse_when(args.since)
    until = parse_when(args.until)
    contacts = {} if args.no_names else load_all_contacts(args.appdir, args.dir)

    matched_profiles = set()
    for profile, record in iter_records(args.dir, args.profile, since, until):
        if pattern_matches(profile, record["u"], args.pattern, contacts, args, {}):
            matched_profiles.add(profile)
    multi_profile = len(matched_profiles) > 1

    # The log grows forward, so keep the LAST n matching records (bounded
    # memory); markers count toward the budget.
    keep = collections.deque(maxlen=args.n) if args.n < sys.maxsize else collections.deque()
    for profile, record in iter_records(args.dir, args.profile, since, until):
        if not pattern_matches(profile, record["u"], args.pattern, contacts, args, {}):
            continue
        if record.get("mark") == "hidden":
            keep.append((profile, record))
            continue
        if args.online_only and not record.get("on"):
            continue
        if args.no_heartbeats and record.get("hb"):
            continue
        keep.append((profile, record))

    if not keep:
        sys.exit("no records match %r (patterns match user ids/numbers and display names)"
                 % args.pattern)

    for profile, record in keep:
        who = display_id(profile, record["u"], contacts, args)
        prefix = ("[%s] " % clean(profile)) if multi_profile else ""
        if record.get("mark") == "hidden":
            print("%s  %s%s marked hidden (skipped)" % (fmt(record["ts"]), prefix, who))
            continue
        kind = "hb " if record.get("hb") else "   "
        print("%s  %s %s%s %s" % (fmt(record["ts"]), kind, prefix, who, status_text(record)))


def cmd_summary(args):
    since = parse_when(args.since)
    until = parse_when(args.until)
    contacts = {} if args.no_names else load_all_contacts(args.appdir, args.dir)
    stats = aggregate(args.dir, args.profile, since, until, args.pattern, contacts, args)
    if not stats:
        sys.exit("no records match %r" % args.pattern)
    for (profile, uid), s in sorted(stats.items(), key=lambda kv: -kv[1]["last_ts"]):
        print("%s / %s" % (clean(profile), display_id(profile, uid, contacts, args)))
        print("  first sample : %s" % (fmt(s["first_obs_ts"]) if s["first_obs_ts"] else "none"))
        print("  last record  : %s" % (fmt(s["last_ts"]) if s["last_ts"] else "none"))
        if skipped_state(s):
            state = "skipped (hidden)"
        elif s["last_state"] is not None:
            state = s["last_state"]
        else:
            state = "unknown"
        print("  last state   : %s" % state)
        print("  online events: %d (genuine samples only)" % s["online"])
        print("  heartbeats   : %d" % s["heartbeats"])
        if s["hidden_ts"]:
            print("  hidden mark  : %s" % fmt(s["hidden_ts"]))


def check(condition, message):
    if not condition:
        raise RuntimeError("self-test FAILED: %s" % message)


def self_test():
    with tempfile.TemporaryDirectory(prefix="nchat-presence-self-test.") as appdir:
        profile = "Telegram_test"
        whatsapp_profile = "WhatsAppMd_test"
        presence_dir = os.path.join(appdir, "presence")
        os.makedirs(presence_dir)
        telegram_path = os.path.join(presence_dir,
                                     "history." + profile.encode().hex() + ".jsonl")
        with open(telegram_path, "w", encoding="utf-8") as fh:
            fh.write('{"ts":1700000000000,"u":"3631323334","on":0,"seen":1699990000000,"recent":0}\n')
            fh.write('{"ts":1700000300000,"u":"3631323334","on":0,"seen":1699990000000,"recent":0,"hb":1}\n')
            fh.write('{"ts":1700000600000,"u":"3631323334","on":1,"seen":-1,"recent":0}\n')
            fh.write('{"ts":1700000900000,"u":"3631323334","on":1,"seen":-1,"recent":0,"hb":1}\n')
            fh.write('{"ts":1700001200000,"u":"3631323334","on":0,"seen":2,"recent":0}\n')
            fh.write('{"ts":1700001500000,"u":"3631323334","on":0,"seen":-1,"recent":1}\n')
            fh.write('{"ts":1700001800000,"u":"3631323334","mark":"hidden"}\n')
            fh.write('{"ts":1700002100000,"u":"3631323334","on":0,"seen":1699990000000,"recent":0}\n')
            fh.write('{"ts":1700002400000}\n')  # schema-violating line
            fh.write('{"ts":1700002700000,"u":"3631323334","on":0,"seen":-1,')  # torn
            fh.write('{"ts":1700003000000,"u":"3631323334","on":0,"seen":"oops","recent":0}\n')  # bad seen
        whatsapp_path = os.path.join(presence_dir,
                                     "history." + whatsapp_profile.encode().hex() + ".jsonl")
        with open(whatsapp_path, "w", encoding="utf-8") as fh:
            fh.write('{"ts":1700000000000,"u":"999888777666@s.whatsapp.net","on":1,"seen":-1,"recent":0}\n')
            fh.write('{"ts":1700000100000,"u":"111222333444@lid","on":0,"seen":-1,"recent":0}\n')
        history_dir = os.path.join(appdir, "history", profile)
        os.makedirs(history_dir)
        con = sqlite3.connect(os.path.join(history_dir, "db.sqlite"))
        con.execute("CREATE TABLE contacts2 (id TEXT, name TEXT, phone TEXT, "
                    "isSelf INT, isAlias INT, UNIQUE(id) ON CONFLICT REPLACE)")
        con.execute("INSERT INTO contacts2 VALUES ('3631323334', 'Test Name', '61234', 0, 0)")
        con.commit()
        con.close()
        wa_dir = os.path.join(appdir, "history", whatsapp_profile)
        os.makedirs(wa_dir)
        con = sqlite3.connect(os.path.join(wa_dir, "db.sqlite"))
        con.execute("CREATE TABLE contacts2 (id TEXT, name TEXT, phone TEXT, "
                    "isSelf INT, isAlias INT, UNIQUE(id) ON CONFLICT REPLACE)")
        con.execute("INSERT INTO contacts2 VALUES ('555111222333@lid', 'Lid Name', '999888777666', 0, 1)")
        con.execute("INSERT INTO contacts2 VALUES ('555444555666@lid', 'Wrong Name', '123456', 0, 1)")
        con.execute("INSERT INTO contacts2 VALUES ('555777888999@lid', 'Masked Name', '+65••••••81', 0, 1)")
        con.commit()
        con.close()

        args = argparse.Namespace(dir=presence_dir, appdir=appdir, profile=None,
                                  pattern="61234", n=200, no_names=False,
                                  no_heartbeats=False, since=None, until=None,
                                  online_only=False)

        output = io.StringIO()
        with contextlib.redirect_stdout(output):
            cmd_list(args)
        listing = output.getvalue()
        check("Test Name <61234>" in listing, "list shows resolved Telegram name")
        check("skipped (hidden)" not in listing, "recovery clears the skipped state")

        output = io.StringIO()
        with contextlib.redirect_stdout(output):
            cmd_summary(args)
        summary = output.getvalue()
        check("Test Name <61234>" in summary, "summary shows resolved name")
        check("online events: 1" in summary, "heartbeats do not count as online events")
        check("heartbeats   : 2" in summary, "heartbeat count is reported separately")
        check("skipped (hidden)" not in summary, "summary is recovery-aware")

        output = io.StringIO()
        with contextlib.redirect_stdout(output):
            cmd_show(args)
        shown = output.getvalue()
        check("offline" in shown and "online" in shown, "show prints states")
        check("seen recently" in shown, "show renders the recent flag")
        check("last week" in shown, "show renders the seen=2 sentinel")
        check("marked hidden" in shown, "show prints the hidden marker")
        check("Test Name <61234>" in shown, "show rows carry contact identity")

        # Last-N semantics: the newest matching record must be shown last.
        args.n = 3
        args.no_heartbeats = True
        output = io.StringIO()
        with contextlib.redirect_stdout(output):
            cmd_show(args)
        lines = [line for line in output.getvalue().splitlines() if line.strip()]
        check(len(lines) == 3, "show -n 3 returns three rows")
        # Markers share the budget: the kept window is recent(22:38), the
        # hidden marker(22:43) and the recovery sample(22:48).
        check("22:38:20" in lines[0] and "22:43:20" in lines[1] and "22:48:20" in lines[2],
              "show keeps the LAST n records (markers included), not the first")
        check("22:13:20" not in output.getvalue(), "older records fall outside the last-N window")
        args.n = 200
        args.no_heartbeats = False

        # WhatsApp phone-column resolution through an unmasked LID entry.
        args.pattern = "Lid Name"
        output = io.StringIO()
        with contextlib.redirect_stdout(output):
            cmd_summary(args)
        check("Lid Name <999888777666>" in output.getvalue(),
              "WhatsApp phone-column resolution through a LID entry")
        # A masked phone must never resolve a full JID.
        args.pattern = "Masked Name"
        try:
            with contextlib.redirect_stdout(io.StringIO()):
                cmd_summary(args)
            check(False, "masked phone must not resolve")
        except SystemExit as exc:
            check(exc.code != 0, "masked phone must not resolve (exit)")
        # A LID uid must never resolve through another contact's phone.
        args.pattern = "111222333444"
        output = io.StringIO()
        with contextlib.redirect_stdout(output):
            cmd_list(args)
        check("Lid Name" not in output.getvalue(), "LID digits are not a phone alias")

        # Time filters: markers respect bounds too. Everything predates 23:00.
        args.pattern = "61234"
        args.since = "2023-11-14 23:00"
        try:
            with contextlib.redirect_stdout(io.StringIO()):
                cmd_show(args)
            check(False, "since filter must exclude older records")
        except SystemExit as exc:
            check(exc.code != 0, "since filter applies")
        args.since = None

        # No-match exits non-zero for both show and summary.
        args.pattern = "does-not-exist"
        for command in (cmd_show, cmd_summary):
            try:
                with contextlib.redirect_stdout(io.StringIO()):
                    command(args)
                check(False, "%s should exit non-zero on no match" % command.__name__)
            except SystemExit as exc:
                check(exc.code != 0, "%s no-match exit code" % command.__name__)

        # --no-names falls back to ids.
        args.pattern = "61234"
        args.no_names = True
        output = io.StringIO()
        with contextlib.redirect_stdout(output):
            cmd_list(args)
        check("Test Name" not in output.getvalue(), "--no-names suppresses names")
        args.no_names = False

        # Unreadable history file degrades gracefully.
        unreadable = os.path.join(presence_dir, "history.626164.jsonl")
        with open(unreadable, "w", encoding="utf-8") as fh:
            fh.write('{"ts":1700000000000,"u":"bad","on":0,"seen":-1,"recent":0}\n')
        os.chmod(unreadable, 0)
        output = io.StringIO()
        with contextlib.redirect_stdout(output):
            cmd_list(args)
        os.chmod(unreadable, 0o600)
    print("self-test: aggregation, recovery, names, search, filters and degradation all passed")
    return 0


def main():
    parser = argparse.ArgumentParser(
        prog=PROGRAM,
        description="Read the local nchat presence history under "
                    "~/.config/nchat/presence/. Patterns match user ids/numbers "
                    "and, when the local cache is readable, display names.")
    parser.add_argument("command", nargs="?", choices=["list", "show", "summary"],
                        help="list contacts / show one contact's history / summarize")
    parser.add_argument("pattern", nargs="?", default="",
                        help="user id, number or display name to filter; required for show")
    parser.add_argument("--dir", default=default_dir(), help="presence directory (default %(default)s)")
    parser.add_argument("--appdir", default=None,
                        help="nchat config dir for display-name lookup (default: parent of --dir)")
    parser.add_argument("--profile", default=None, help="only match profiles containing this text")
    parser.add_argument("-n", type=int, default=200, help="last N records for show (default 200)")
    parser.add_argument("--all", action="store_true", help="show all matching records (overrides -n)")
    parser.add_argument("--no-heartbeats", action="store_true",
                        help="hide heartbeat re-affirmation lines in show")
    parser.add_argument("--since", default=None, metavar="WHEN",
                        help="only records at or after WHEN (YYYY-MM-DD or YYYY-MM-DD HH:MM)")
    parser.add_argument("--until", default=None, metavar="WHEN",
                        help="only records at or before WHEN (YYYY-MM-DD or YYYY-MM-DD HH:MM)")
    parser.add_argument("--online-only", action="store_true",
                        help="in show, only online samples and hidden markers")
    parser.add_argument("--no-names", action="store_true",
                        help="do not resolve display names from the local cache")
    parser.add_argument("--self-test", action="store_true", help=argparse.SUPPRESS)
    args = parser.parse_args()

    if args.n <= 0:
        parser.error("-n must be a positive number of records")
    if args.all:
        args.n = sys.maxsize
    since = parse_when(args.since)
    until = parse_when(args.until)
    if since is not None and until is not None and since > until:
        parser.error("--since must not be later than --until")

    if args.appdir is None:
        args.appdir = os.path.dirname(os.path.abspath(args.dir))

    if args.self_test:
        return self_test()
    if args.command == "list" or args.command is None:
        cmd_list(args)
    elif args.command == "show":
        if not args.pattern:
            sys.exit("show needs a user id pattern")
        cmd_show(args)
    elif args.command == "summary":
        cmd_summary(args)
    return 0


if __name__ == "__main__":
    sys.exit(main())
